{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnenglishwithplay.app/schemas/grammar-point.schema.json",
  "title": "GrammarPoint",
  "description": "One teachable structure. See docs/03-GRAMMAR-SYLLABUS.md §2.",
  "type": "object",
  "required": ["id", "level", "label", "form", "meaning", "use",
               "prerequisites", "known_errors", "exercise_types",
               "can_do", "status", "syllabus_version"],
  "additionalProperties": false,
  "properties": {
    "id":    { "type": "string", "pattern": "^G-[0-9]{3}$" },
    "level": { "enum": ["A1.1","A1.2","A2.1","A2.2","B1.1","B1.2",
                        "B2.1","B2.2","C1","C2"] },
    "label": { "type": "string", "minLength": 3 },
    "form":  { "type": "string", "minLength": 3 },
    "meaning": { "type": "string", "minLength": 3 },
    "use":     { "type": "string", "minLength": 3 },
    "explanation": {
      "type": "object",
      "description": "Learner-facing. Max 40 words per docs/03 §11.",
      "required": ["en"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "en": { "type": "string", "minLength": 3 },
        "uz": { "type": "string" }
      }
    },
    "diagram": { "enum": ["timeline","word_order","tree","table","none"] },
    "positive_example": { "type": "string" },
    "negative_example": { "type": "string" },
    "prerequisites": { "type": "array",
      "items": { "type": "string", "pattern": "^G-[0-9]{3}$" } },
    "contrasts_with": { "type": "array",
      "items": { "type": "string", "pattern": "^G-[0-9]{3}$" } },
    "clinic": { "type": "string", "pattern": "^C-[0-9]{2}$" },
    "known_errors": { "type": "array", "minItems": 1,
      "items": { "type": "string" } },
    "l1_notes": { "type": "object", "additionalProperties": { "type": "string" } },
    "l1_weight": { "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0.1, "maximum": 3 } },
    "exercise_types": { "type": "array", "minItems": 3,
      "items": { "type": "string" } },
    "can_do": { "type": "string", "minLength": 5 },
    "exam_tags": { "type": "array", "items": { "type": "string" } },
    "first_taught_node": { "type": "string",
      "pattern": "^S[0-9]{2}U[0-9]{2}N[0-9]$" },
    "status": { "enum": ["draft","review","published","deprecated"] },
    "syllabus_version": { "type": "string" }
  }
}
