{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnenglishwithplay.app/schemas/lexeme.schema.json",
  "title": "Lexeme",
  "description": "One lemma in one sense. See docs/04-LEXIS-SPEC.md §11.",
  "type": "object",
  "required": ["id", "lemma", "sense_id", "pos", "cefr", "frequency", "phonology",
               "spelling", "audio", "examples", "l1_gloss", "topic_tags",
               "first_taught_node", "status", "syllabus_version"],
  "additionalProperties": false,
  "properties": {
    "id":       { "type": "string", "pattern": "^lex\\.[0-9]{5}$" },
    "lemma":    { "type": "string", "minLength": 1 },
    "sense_id": { "type": "integer", "minimum": 1 },
    "sense_gloss_en": { "type": "string" },
    "pos": { "enum": ["noun","verb","adj","adv","pron","det","prep","conj",
                      "num","interj","aux","modal","phrase","particle"] },
    "cefr": { "enum": ["A1.1","A1.2","A2.1","A2.2","B1.1","B1.2",
                       "B2.1","B2.2","C1","C2"] },
    "frequency": {
      "type": "object",
      "required": ["band"],
      "additionalProperties": false,
      "properties": {
        "band":        { "enum": [1000, 2000, 3000, 4000, 5000, 6000, 8000,
                                  10000, 14000, 20000, 99999] },
        "coca_rank":   { "type": "integer", "minimum": 1 },
        "subtlex_rank":{ "type": "integer", "minimum": 1 },
        "dispersion":  { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "phonology": {
      "type": "object",
      "required": ["ipa_ga", "syllables", "stress"],
      "additionalProperties": false,
      "properties": {
        "ipa_ga":    { "type": "string", "minLength": 1 },
        "ipa_sbe":   { "type": "string" },
        "syllables": { "type": "integer", "minimum": 1 },
        "stress":    { "type": "string", "pattern": "^[0-9](,[0-9])*$" },
        "teaches":   { "type": "array", "items": { "type": "string",
                       "pattern": "^P-[0-9]{3}$" } }
      }
    },
    "spelling": {
      "type": "object",
      "required": ["us", "uk"],
      "additionalProperties": false,
      "properties": {
        "us":          { "type": "string" },
        "uk":          { "type": "string" },
        "inflections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audio": {
      "type": "object",
      "required": ["word_ga"],
      "additionalProperties": false,
      "properties": {
        "word_ga":  { "type": "string" },
        "word_sbe": { "type": "string" },
        "slow_ga":  { "type": "string" }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns":  { "type": "array", "items": { "type": "string" } },
        "irregular": { "type": "boolean" },
        "countable": { "type": ["boolean", "null"] },
        "plural":    { "type": "string" },
        "comparative": { "type": "string" },
        "superlative": { "type": "string" }
      }
    },
    "collocations":  { "type": "array", "items": { "type": "string" } },
    "colligations":  { "type": "array", "items": { "type": "string" } },
    "register":    { "enum": ["neutral","informal","formal","very_formal",
                              "slang","technical","dated"] },
    "connotation": { "enum": ["neutral","positive","negative"] },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text":  { "type": "string", "minLength": 2 },
          "audio": { "type": "string" },
          "uz":    { "type": "string" },
          "chunk": { "type": "boolean" }
        }
      }
    },
    "l1_gloss": {
      "type": "object",
      "required": ["uz"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "uz": { "type": "string", "minLength": 1 },
        "ru": { "type": "string" }
      }
    },
    "l1_traps": { "type": "object", "additionalProperties": { "type": "string" } },
    "images":   { "type": "array", "items": { "type": "string" } },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synonyms": { "type": "array", "items": { "type": "string" } },
        "antonyms": { "type": "array", "items": { "type": "string" } },
        "family":   { "type": "array", "items": { "type": "string" } },
        "interferes_with": { "type": "array",
          "items": { "type": "string", "pattern": "^lex\\.[0-9]{5}$" } }
      }
    },
    "topic_tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "first_taught_node": { "type": "string",
      "pattern": "^S[0-9]{2}U[0-9]{2}N[0-9]$" },
    "is_chunk":  { "type": "boolean" },
    "is_function_word": { "type": "boolean" },
    "status":    { "enum": ["draft","review","published","deprecated"] },
    "syllabus_version": { "type": "string" }
  }
}
