{"id":"F-023","level":"A1.1","category":"directive","label":"Asking for something (requesting)","exponents":[{"text":"Two coffees, please.","formality":"neutral","notes":"Standard service transaction."},{"text":"Can I have a coffee, please?","formality":"neutral"},{"text":"Could I have a coffee, please?","formality":"polite"},{"text":"I'd like a coffee, please.","formality":"polite"},{"text":"Give me a coffee.","formality":"rude","notes":"Receptive only — flag as impolite."}],"responses":["Sure.","Of course.","Here you are."],"known_failures":["Bare imperative to a stranger","*I want a coffee. (too direct in a shop)","Missing 'please'"],"l1_note":{"uz":"'I want' do'kon va kafeda juda to'g'ridan-to'g'ri eshitiladi. 'Can I have…' yoki 'I'd like…' ishlating."},"unit":"S01U10","status":"published","syllabus_version":"1.0"},
