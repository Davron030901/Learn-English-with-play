{"id":"F-001","level":"A1.1","category":"social_ritual","label":"Greeting someone","exponents":[{"text":"Hi!","formality":"informal"},{"text":"Hello!","formality":"neutral"},{"text":"Good morning / afternoon / evening.","formality":"neutral_formal"},{"text":"Hi, how are you?","formality":"informal"}],"responses":["Hi!","Hello!","Good morning."],"prosody":"Falling on the greeting; warm, wide pitch range.","known_failures":["Using 'Good night' as a greeting","No response at all — silence reads as unfriendly"],"l1_note":{"uz":"Ingliz tilida salomlashish qisqa. 'How are you?' — bu haqiqiy savol emas, marosim. Javob: 'Fine, thanks. And you?'"},"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-002","level":"A1.1","category":"social_ritual","label":"Asking how someone is and responding","exponents":[{"text":"How are you?","formality":"neutral"},{"text":"How are you doing?","formality":"informal"},{"text":"Are you OK?","formality":"informal"}],"responses":["Fine, thanks. And you?","I'm good, thanks.","Not bad, thanks.","Very well, thank you."],"prosody":"Falling on 'How are YOU'; the reply's 'And you?' rises.","known_failures":["Giving a long, real answer about your health","Answering only 'Fine' without returning the question"],"l1_note":{"uz":"To'liq sog'liq hisoboti bermang — bu shunchaki salomlashish. Savolni qaytaring: 'And you?'"},"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-003","level":"A1.1","category":"social_ritual","label":"Introducing yourself","exponents":[{"text":"I'm Aziz.","formality":"informal"},{"text":"My name is Aziz.","formality":"neutral"},{"text":"My name's Aziz Karimov.","formality":"neutral"}],"responses":["Nice to meet you.","Nice to meet you too."],"known_failures":["*My name Aziz. (missing 'is')","*I am name Aziz."],"l1_note":{"uz":"'is' tushib qolmasin: 'My name IS Aziz'."},"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-004","level":"A1.1","category":"social_ritual","label":"Introducing another person","exponents":[{"text":"This is my friend, Bobur.","formality":"neutral"},{"text":"This is Kamola. She's my sister.","formality":"neutral"}],"responses":["Nice to meet you.","Hello, nice to meet you."],"known_failures":["Using 'he' for a woman","*This is my friend, he is Bobur. (redundant)"],"l1_note":{"uz":"Odamni tanishtirganda 'This is…' ishlatiladi, 'He is…' emas."},"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-005","level":"A1.1","category":"social_ritual","label":"Saying goodbye","exponents":[{"text":"Bye!","formality":"informal"},{"text":"See you later. / See you tomorrow.","formality":"informal"},{"text":"Goodbye.","formality":"neutral_formal"},{"text":"Good night.","formality":"neutral","notes":"Only when leaving at night or going to bed."}],"responses":["Bye!","See you!","Goodbye."],"known_failures":["'Good night' used on arrival"],"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-006","level":"A1.1","category":"politeness","label":"Thanking and responding","exponents":[{"text":"Thanks.","formality":"informal"},{"text":"Thank you.","formality":"neutral"},{"text":"Thank you very much.","formality":"neutral"},{"text":"That's very kind of you.","formality":"formal"}],"responses":["You're welcome.","No problem.","That's OK.","Not at all."],"known_failures":["Silence after 'Thank you' — reads as cold","*Thanks you."],"l1_note":{"uz":"Javob berish SHART — jim qolish sovuqlik belgisi."},"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-007","level":"A1.1","category":"politeness","label":"Apologising","exponents":[{"text":"Sorry.","formality":"informal"},{"text":"I'm sorry.","formality":"neutral"},{"text":"I'm very sorry.","formality":"neutral"},{"text":"I'm sorry I'm late.","formality":"neutral"}],"responses":["That's OK.","No problem.","Don't worry."],"known_failures":["Using 'Excuse me' to apologise for a mistake"],"l1_note":{"uz":"'Sorry' — xato uchun uzr; 'Excuse me' — murojaat qilish yoki o'tib ketish uchun."},"unit":"S01U01","status":"published","syllabus_version":"1.0"},
{"id":"F-008","level":"A1.1","category":"politeness","label":"Getting someone's attention","exponents":[{"text":"Excuse me.","formality":"neutral"},{"text":"Excuse me, can I ask you something?","formality":"neutral"}],"responses":["Yes?","Sure.","How can I help you?"],"known_failures":["Starting with 'Hey!' with a stranger","Using 'Sorry' where 'Excuse me' is needed"],"unit":"S01U01","status":"published","syllabus_version":"1.0"},
