  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "gen": "node scripts/gen-design.mjs && node scripts/gen-sounds.mjs && node scripts/gen-api.mjs && node scripts/pack-content.mjs",
    "gen:design": "node scripts/gen-design.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:content": "node scripts/pack-content.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p e2e",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:sweep": "vitest run tests/sweep",
    "test:components": "jest",
    "export:web": "node scripts/export-web.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:components",
    "serve:web": "node scripts/serve-web.mjs dist",
    "gen:sounds": "node scripts/gen-sounds.mjs"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
