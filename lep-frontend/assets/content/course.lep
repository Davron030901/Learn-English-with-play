2N2","focus":"grammar","title":"The mismatch the reader sees","tiers":{"1":5,"2":3,"3":3}},{"id":"S10U02N3","focus":"mixed","title":"Not unhelpful","tiers":{"1":15,"2":13,"3":14}},{"id":"S10U02N4","focus":"","title":"Story","tiers":{"1":2,"2":2,"3":3}},{"id":"S10U02N5","focus":"mixed","title":"Reading the reserve","tiers":{"1":13,"2":11,"3":12}},{"id":"S10U02N6","focus":"function","title":"Saying it dry","tiers":{"1":10,"2":10,"3":10}},{"id":"S10U02N7","focus":"","title":"Read and listen","tiers":{}},{"id":"S10U02N8","focus":"","title":"Review","tiers":{}}]},{"id":"S10U03","n":147,"cefr":"C2","title":{"en":"A man of few words","uz":"Kamgap odam"},"can_do":["I can place the surprising element where a joke needs it.","I can break a convention so the reader sees it as a choice.","I can make a point land in a room without losing the argument."],"minutes":{"t1":53,"t2":46,"t3":40},"story":{"id":"txt.00147","title":"A man of few words"},"nodes":[{"id":"S10U03N1","focus":"lexis","title":"The surprise goes last","tiers":{"1":30,"2":23,"3":19}},{"id":"S10U03N2","focus":"grammar","title":"And that was that","tiers":{"1":5,"2":3,"3":3}},{"id":"S10U03N3","focus":"mixed","title":"Fragment or accident","tiers":{"1":15,"2":13,"3":14}},{"id":"S10U03N4","focus":"","title":"Story","tiers":{"1":3,"2":3,"3":4}},{"id":"S10U03N5","focus":"mixed","title":"One rule, not four","tiers":{"1":13,"2":11,"3":12}},{"id":"S10U03N6","focus":"function","title":"Timing aloud","tiers":{"1":10,"2":10,"3":10}},{"id":"S10U03N7","focus":"","title":"Read and listen","tiers":{}},{"id":"S10U03N8","focus":"","title":"Review","tiers":{}}]},{"id":"S10U04","n":148,"cefr":"C2","title":{"en":"Both ministers could sign it","uz":"Ikkala vazir ham imzolay oladi"},"can_do":["I can tell a deliberate ambiguity from an accidental one in my own writing.","I can name a presupposition instead of conceding it by answering.","I can leave a question open on purpose and say that I have."],"minutes":{"t1":53,"t2":46,"t3":40},"st