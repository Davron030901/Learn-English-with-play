00137","title":"Granted, the sample is small"},"nodes":[{"id":"S09U17N1","focus":"lexis","title":"Hearing the objection","tiers":{"1":29,"2":22,"3":19}},{"id":"S09U17N2","focus":"grammar","title":"Granted, admittedly, true","tiers":{"1":5,"2":3,"3":3}},{"id":"S09U17N3","focus":"mixed","title":"Be that as it may","tiers":{"1":15,"2":13,"3":14}},{"id":"S09U17N4","focus":"","title":"Story","tiers":{"1":2,"2":2,"3":3}},{"id":"S09U17N5","focus":"mixed","title":"Concession and dismissal","tiers":{"1":13,"2":11,"3":11}},{"id":"S09U17N6","focus":"function","title":"Disagreeing well","tiers":{"1":10,"2":10,"3":10}},{"id":"S09U17N7","focus":"","title":"Read and listen","tiers":{}},{"id":"S09U17N8","focus":"","title":"Review","tiers":{}}]},{"id":"S09U18","n":138,"cefr":"C1","title":{"en":"The argument so far","uz":"Shu paytgacha bo'lgan dalil"},"can_do":["I can tell a reader where they are in a long text.","I can signpost a move without taking longer than the move.","I can package a passage into a single labelled noun phrase."],"minutes":{"t1":53,"t2":46,"t3":40},"story":{"id":"txt.00138","title":"The argument so far"},"nodes":[{"id":"S09U18N1","focus":"lexis","title":"Where the reader is","tiers":{"1":32,"2":24,"3":22}},{"id":"S09U18N2","focus":"grammar","title":"I turn now to","tiers":{"1":5,"2":3,"3":3}},{"id":"S09U18N3","focus":"mixed","title":"This silence is itself evidence","tiers":{"1":13,"2":11,"3":12}},{"id":"S09U18N4","focus":"","title":"Story","tiers":{"1":1,"2":1,"3":2}},{"id":"S09U18N5","focus":"mixed","title":"Naming a passage","tiers":{"1":13,"2":11,"3":11}},{"id":"S09U18N6","focus":"function","title":"Guiding a listener","tiers":{"1":10,"2":10,"3":10}},{"id":"S09U18N7","focus":"","title":"Read and listen","tiers":{}},{"id":"S09U18N8","focus":"","title":"Review","tiers":{}}]},{"id":"S09U19","n":139,"cefr":"C1","title":{"en":"The survey indicates","uz":"So'rov ko'rsatmoqda"},"can_do":["I can match my wording to the strength of my evidence.","I can run the scale 