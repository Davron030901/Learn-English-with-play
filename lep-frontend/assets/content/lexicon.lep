ключать","ex":["Switch off your phone."],"u":"S03U06"},{"id":"lex.01105","w":"press","pos":"verb","ipa":"pres","uz":"bosmoq","ru":"нажимать","ex":["Press this button."],"u":"S03U06"},{"id":"lex.01106","w":"button","pos":"noun","ipa":"ˈbʌtən","uz":"tugma","ru":"кнопка","ex":["Press the green button."],"u":"S03U06"},{"id":"lex.01107","w":"website","pos":"noun","ipa":"ˈwebsaɪt","uz":"veb-sayt","ru":"сайт","ex":["Visit our website."],"u":"S03U06"},{"id":"lex.01108","w":"online","pos":"adj","ipa":"ˌɑːnˈlaɪn","uz":"onlayn","ru":"онлайн","ex":["I bought it online."],"u":"S03U06"},{"id":"lex.01109","w":"social media","pos":"noun","ipa":"ˈsoʊʃəl ˈmiːdiə","uz":"ijtimoiy tarmoq","ru":"соцсети","ex":["She spends hours on social media."],"u":"S03U06"},{"id":"lex.01110","w":"message","pos":"verb","ipa":"ˈmesɪdʒ","uz":"xabar yubormoq","ru":"писать сообщение","ex":["Message me later."],"u":"S03U06"},{"id":"lex.01111","w":"delete","pos":"verb","ipa":"dɪˈliːt","uz":"o'chirmoq","ru":"удалять","ex":["Delete that message."],"u":"S03U06"},{"id":"lex.01112","w":"useful","pos":"adj","ipa":"ˈjuːsfəl","uz":"foydali","ru":"полезный","ex":["This app is very useful."],"u":"S03U06"},{"id":"lex.01113","w":"useless","pos":"adj","ipa":"ˈjuːsləs","uz":"foydasiz","ru":"бесполезный","ex":["This phone is useless now."],"u":"S03U06"},{"id":"lex.01114","w":"machine","pos":"noun","ipa":"məˈʃiːn","uz":"mashina, apparat","ru":"машина","ex":["The washing machine is broken."],"u":"S03U06"},{"id":"lex.01115","w":"invent","pos":"verb","ipa":"ɪnˈvent","uz":"ixtiro qilmoq","ru":"изобретать","ex":["Who invented the telephone?"],"u":"S03U06"},{"id":"lex.01116","w":"review","pos":"verb","ipa":"rɪˈvjuː","uz":"qayta ko'rib chiqmoq","ru":"пересматривать","ex":["The rule will be reviewed in June."],"u":"S03U07"},{"id":"lex.01117","w":"recent","pos":"adj","ipa":"ˈriːsənt","uz":"yaqinda bo'lgan","ru":"недавний","ex":["There has been a recent change."],"u":"S03U07"},{"id":"lex.01118","w":"successful","pos":"adj","ipa":"sək