:"S02U08"},{"id":"lex.00721","w":"alone","pos":"adv","ipa":"əˈloʊn","uz":"yolg'iz","ru":"один","ex":["I travelled alone."],"u":"S02U08"},{"id":"lex.00722","w":"why","pos":"adv","ipa":"waɪ","uz":"nega","ru":"почему","ex":["Why are you late?"],"u":"S02U08"},{"id":"lex.00723","w":"which","pos":"det","ipa":"wɪtʃ","uz":"qaysi","ru":"который","ex":["Which one do you want?"],"u":"S02U08"},{"id":"lex.00724","w":"camera","pos":"noun","ipa":"ˈkæmrə","uz":"kamera","ru":"камера","ex":["I took my camera to Khiva."],"u":"S02U08"},{"id":"lex.00725","w":"souvenir","pos":"noun","ipa":"ˌsuːvəˈnɪr","uz":"esdalik sovg'a","ru":"сувенир","ex":["I bought some souvenirs in Bukhara."],"u":"S02U08"},{"id":"lex.00726","w":"postcard","pos":"noun","ipa":"ˈpoʊstkɑːrd","uz":"otkritka","ru":"открытка","ex":["I sent a postcard to my sister."],"u":"S02U08"},{"id":"lex.00727","w":"third","pos":"num","ipa":"θɜːrd","uz":"uchinchi","ru":"третий","ex":["We live on the third floor."],"u":"S02U08"},{"id":"lex.00728","w":"matter","pos":"noun","ipa":"ˈmætər","uz":"masala","ru":"дело, вопрос","ex":["It is a serious matter."],"u":"S02U09"},{"id":"lex.00729","w":"matter","pos":"verb","ipa":"ˈmætər","uz":"ahamiyatli bo'lmoq","ru":"иметь значение","ex":["It does not matter."],"u":"S02U09"},{"id":"lex.00730","w":"own","pos":"verb","ipa":"oʊn","uz":"egalik qilmoq","ru":"владеть","ex":["They own two shops."],"u":"S02U09"},{"id":"lex.00731","w":"reply","pos":"verb","ipa":"rɪˈplaɪ","uz":"javob bermoq","ru":"отвечать","ex":["She replied the same day."],"u":"S02U09"},{"id":"lex.00732","w":"list","pos":"noun","ipa":"lɪst","uz":"ro'yxat","ru":"список","ex":["Her name is on the list."],"u":"S02U09"},{"id":"lex.00733","w":"line","pos":"noun","ipa":"laɪn","uz":"satr, chiziq","ru":"строка, линия","ex":["Read the first line again."],"u":"S02U09"},{"id":"lex.00734","w":"expect","pos":"verb","ipa":"ɪkˈspekt","uz":"kutmoq","ru":"ожидать","ex":["We expect ten people."],"u":"S02U09"},{"id":"lex.00735","w":"tomorrow","pos":"adv","ipa":"təˈmɑːroʊ","uz":"ertaga","ru":"завтра","ex":["I'm going to Samarkand tomorrow."],"u":"S02U09"},{"id":"lex.00736","w":"soon","pos":"adv","ipa":"suːn","uz":"tez orada","ru":"скоро","ex":["I'll see you soon."],"u":"S02U09"},{"id":"lex.00737","w":"tonight","pos":"adv","ipa":"təˈnaɪt","uz":"bugun kechqurun","ru":"сегодня вечером","ex":["What are you doing tonight?"],"u":"S02U09"},{"id":"lex.00738","w":"future","pos":"noun","ipa":"ˈfjuːtʃər","uz":"kelajak","ru":"будущее","ex":["What do you want to do in the future?"],"u":"S02U09"},{"id":"lex.00739","w":"plan","pos":"noun","ipa":"plæn","uz":"reja","ru":"план","ex":["What are your plans for the weekend?"],"u":"S02U09"},{"id":"lex.00740","w":"career","pos":"noun","ipa":"kəˈrɪr","uz":"kasb yo'li","ru":"карьера","ex":["She wants a career in medicine."],"u":"S02U09"},{"id":"lex.00741","w":"marriage","pos":"noun","ipa":"ˈmerɪdʒ","uz":"nikoh","ru":"брак","ex":["Their marriage is very happy."],"u":"S02U09"},{"id":"lex.00742","w":"retire","pos":"verb","ipa":"rɪˈtaɪər","uz":"nafaqaga chiqmoq","ru":"выходить на пенсию","ex":["My father is going to retire next year."],"u":"S02U09"},{"id":"lex.00743","w":"graduate","pos":"verb","ipa":"ˈɡrædʒueɪt","uz":"bitirmoq","ru":"окончить","ex":["I'm going to graduate in June."],"u":"S02U09"},{"id":"lex.00744","w":"dream","pos":"noun","ipa":"driːm","uz":"orzu, tush","ru":"мечта, сон","ex":["My dream is to live abroad."],"u":"S02U09"},{"id":"lex.00745","w":"hope","pos":"verb","ipa":"hoʊp","uz":"umid qilmoq","ru":"надеяться","ex":["I hope you're well."],"u":"S02U09"},{"id":"lex.00746","w":"wish","pos":"noun","ipa":"wɪʃ","uz":"tilak","ru":"желание","ex":["Best wishes!"],"u":"S02U09"},{"id":"lex.00747","w":"decide","pos":"verb","ipa":"dɪˈsaɪd","uz":"qaror qilmoq","ru":"решать","ex":["I decided to study medicine."],"u":"S02U09"},{"id":"lex.00748","w":"stop","pos":"verb","ipa":"stɑːp","uz":"to'xtatmoq","ru":"останавливать","ex":["Stop here, please."],"u":"S02U09"},{"id":"lex.00749","w":"continue","pos":"verb","ipa":"kənˈtɪnjuː","uz":"davom ettirmoq","ru":"продолжать","ex":["Continue reading, please."],"u":"S02U09"},{"id":"lex.00750","w":"goal","pos":"noun","ipa":"ɡoʊl","uz":"maqsad","ru":"цель","ex":["My goal is to speak English well."],"u":"S02U09"},{"id":"lex.00751","w":"chance","pos":"noun","ipa":"tʃæns","uz":"imkoniyat","ru":"шанс","ex":["This is a good chance for me."],"u":"S02U09"},{"id":"lex.00752","w":"free","pos":"adj","ipa":"friː","uz":"bo'sh; bepul","ru":"свободный; бесплатный","ex":["Are you free on Saturday?"],"u":"S02U09"},{"id":"lex.00753","w":"possible","pos":"adj","ipa":"ˈpɑːsəbəl","uz":"mumkin","ru":"возможный","ex":["Is it possible to change the date?"],"u":"S02U09"},{"id":"lex.00754","w":"important","pos":"adj","ipa":"ɪmˈpɔːrtənt","uz":"muhim","ru":"важный","ex":["This is very important."],"u":"S02U09"},{"id":"lex.00755","w":"sure","pos":"adj","ipa":"ʃʊr","uz":"ishonchli","ru":"уверенный","ex":["I'm not sure."],"u":"S02U09"},{"id":"lex.00756","w":"appointment","pos":"noun","ipa":"əˈpɔɪntmənt","uz":"uchrashuv (rasmiy)","ru":"приём, встреча","ex":["I have an appointment with the doctor."],"u":"S02U09"},{"id":"lex.00757","w":"diary","pos":"noun","ipa":"ˈdaɪəri","uz":"kundalik","ru":"ежедневник","ex":["It's in my diary."],"u":"S02U09"},{"id":"lex.00758","w":"schedule","pos":"noun","ipa":"ˈskedʒuːl","uz":"jadval","ru":"расписание","ex":["My schedule is very busy this week."],"u":"S02U09"},{"id":"lex.00759","w":"invite","pos":"verb","ipa":"ɪnˈvaɪt","uz":"taklif qilmoq","ru":"приглашать","ex":["I invited ten friends."],"u":"S02U09"},{"id":"lex.00760","w":"join","pos":"verb","ipa":"dʒɔɪn","uz":"qo'shilmoq","ru":"присоединяться","ex":["Would you like to join us?"],"u":"S02U09"},{"id":"lex.00761","w":"apply","pos":"verb","ipa":"əˈplaɪ","uz":"ariza bermoq","ru":"подавать заявление","ex":["I applied for a new job."],"u":"S02U09"},{"id":"lex.00762","w":"save","pos":"verb","ipa":"seɪv","uz":"tejamoq, saqlamoq","ru":"копить, сохранять","ex":["I'm saving money for a car."],"u":"S02U09"},{"id":"lex.00763","w":"the day after tomorrow","pos":"phrase","ipa":"ðə ˌdeɪ ˈæftər təˈmɑːroʊ","uz":"indinga","ru":"послезавтра","ex":["The exam is the day after tomorrow."],"u":"S02U09"},{"id":"lex.00764","w":"in the future","pos":"phrase","ipa":"ɪn ðə ˈfjuːtʃər","uz":"kelajakda","ru":"в будущем","ex":["In the future I want to be a teacher."],"u":"S02U09"},{"id":"lex.00765","w":"one day","pos":"phrase","ipa":"ˌwʌn ˈdeɪ","uz":"bir kun","ru":"однажды","ex":["One day I want to visit Japan."],"u":"S02U09"},{"id":"lex.00766","w":"next week","pos":"phrase","ipa":"ˌnekst ˈwiːk","uz":"kelasi hafta","ru":"на следующей неделе","ex":["I'm starting a new job next week."],"u":"S02U09"},{"id":"lex.00767","w":"next year","pos":"phrase","ipa":"ˌnekst ˈjɪr","uz":"kelasi yil","ru":"в следующем году","ex":["We're moving next year."],"u":"S02U09"},{"id":"lex.00768","w":"birth","pos":"noun","ipa":"bɜːrθ","uz":"tug'ilish","ru":"рождение","ex":["What's your date of birth?"],"u":"S02U09"},{"id":"lex.00769","w":"promise","pos":"verb","ipa":"ˈprɑːmɪs","uz":"va'da bermoq","ru":"обещать","ex":["He promised to call."],"u":"S02U10"},{"id":"lex.00770","w":"surprise","pos":"verb","ipa":"sərˈpraɪz","uz":"hayratda qoldirmoq","ru":"удивлять","ex":["The answer surprised me."],"u":"S02U10"},{"id":"lex.00771","w":"spread","pos":"verb","ipa":"spred","uz":"tarqalmoq, yoymoq","ru":"распространяться, расстилать","ex":["The news spread through the village by evening."],"u":"S02U10"},{"id":"lex.00772","w":"thank","pos":"verb","ipa":"θæŋk","uz":"minnatdorchilik bildirmoq","ru":"благодарить","ex":["I want to thank you."],"u":"S02U10"},{"id":"lex.00773","w":"invitation","pos":"noun","ipa":"ˌɪnvɪˈteɪʃən","uz":"taklifnoma","ru":"приглашение","ex":["Thank you for the invitation."],"u":"S02U10"},{"id":"lex.00774","w":"accept","pos":"verb","ipa":"əkˈsept","uz":"qabul qilmoq","ru":"принимать","ex":["I accept your invitation."],"u":"S02U10"},{"id":"lex.00775","w":"refuse","pos":"verb","ipa":"rɪˈfjuːz","uz":"rad etmoq","ru":"отказываться","ex":["He refused my offer."],"u":"S02U10"},{"id":"lex.00776","w":"agree","pos":"verb","ipa":"əˈɡriː","uz":"rozi bo'lmoq","ru":"соглашаться","ex":["I agree with you."],"u":"S02U10"},{"id":"lex.00777","w":"suggest","pos":"verb","ipa":"səɡˈdʒest","uz":"taklif qilmoq","ru":"предлагать","ex":["I suggest going by taxi."],"u":"S02U10"},{"id":"lex.00778","w":"offer","pos":"verb","ipa":"ˈɔːfər","uz":"taklif etmoq","ru":"предлагать","ex":["She offered me a cup of tea."],"u":"S02U10"},{"id":"lex.00779","w":"guest","pos":"noun","ipa":"ɡest","uz":"mehmon","ru":"гость","ex":["We have guests tonight."],"u":"S02U10"},{"id":"lex.00780","w":"gift","pos":"noun","ipa":"ɡɪft","uz":"sovg'a","ru":"подарок","ex":["This is a small gift for you."],"u":"S02U10"},{"id":"lex.00781","w":"flowers","pos":"noun","ipa":"ˈflaʊərz","uz":"gullar","ru":"цветы","ex":["He brought flowers for his wife."],"u":"S02U10"},{"id":"lex.00782","w":"celebrate","pos":"verb","ipa":"ˈseləbreɪt","uz":"nishonlamoq","ru":"праздновать","ex":["We celebrate Navruz in March."],"u":"S02U10"},{"id":"lex.00783","w":"congratulations","pos":"interj","ipa":"kənˌɡrætʃəˈleɪʃənz","uz":"tabriklaymiz","ru":"поздравляю","ex":["Congratulations on your new job!"],"u":"S02U10"},{"id":"lex.00784","w":"welcome","pos":"interj","ipa":"ˈwelkəm","uz":"xush kelibsiz","ru":"добро пожаловать","ex":["Welcome to Tashkent!"],"u":"S02U10"},{"id":"lex.00785","w":"arrange","pos":"verb","ipa":"əˈreɪndʒ","uz":"tashkil qilmoq","ru":"организовать","ex":["Let's arrange a meeting."],"u":"S02U10"},{"id":"lex.00786","w":"cancel","pos":"verb","ipa":"ˈkænsəl","uz":"bekor qilmoq","ru":"отменять","ex":["I have to cancel our meeting."],"u":"S02U10"},{"id":"lex.00787","w":"confirm","pos":"verb","ipa":"kənˈfɜːrm","uz":"tasdiqlamoq","ru":"подтверждать","ex":["Please confirm the time."],"u":"S02U10"},{"id":"lex.00788","w":"available","pos":"adj","ipa":"əˈveɪləbəl","uz":"mavjud, bo'sh","ru":"доступный","ex":["Is the room available on Friday?"],"u":"S02U10"},{"id":"lex.00789","w":"theatre","pos":"noun","ipa":"ˈθiːətər","uz":"teatr","ru":"театр","ex":["We went to the theatre last night."],"u":"S02U10"},{"id":"lex.00790","w":"club","pos":"noun","ipa":"klʌb","uz":"klub","ru":"клуб","ex":["I joined a football club."],"u":"S02U10"},{"id":"lex.00791","w":"gym","pos":"noun","ipa":"dʒɪm","uz":"sport zali","ru":"спортзал","ex":["I go to the gym three times a week."],"u":"S02U10"},{"id":"lex.00792","w":"zoo","pos":"noun","ipa":"zuː","uz":"hayvonot bog'i","ru":"зоопарк","ex":["We took the children to the zoo."],"u":"S02U10"},{"id":"lex.00793","w":"how about","pos":"phrase","ipa":"ˌhaʊ əˈbaʊt","uz":"…-chi?","ru":"как насчёт","ex":["How about Saturday?"],"u":"S02U10"},{"id":"lex.00794","w":"why don't we","pos":"phrase","ipa":"ˌwaɪ doʊnt ˈwiː","uz":"nega … qilmaymiz?","ru":"почему бы нам не","ex":["Why don't we meet at six?"],"u":"S02U10"},{"id":"lex.00795","w":"would you like to","pos":"phrase","ipa":"wʊd ju ˈlaɪk tuː","uz":"…-ni xohlaysizmi?","ru":"хотели бы вы","ex":["Would you like to come with us?"],"u":"S02U10"},{"id":"lex.00796","w":"I'd love to","pos":"phrase","ipa":"aɪd ˈlʌv tuː","uz":"juda xursand bo'lardim","ru":"с удовольствием","ex":["I'd love to, thank you!"],"u":"S02U10"},{"id":"lex.00797","w":"that sounds good","pos":"phrase","ipa":"ðæt ˌsaʊndz ˈɡʊd","uz":"yaxshi fikr","ru":"звучит хорошо","ex":["That sounds good — see you at seven."],"u":"S02U10"},{"id":"lex.00798","w":"maybe","pos":"adv","ipa":"ˈmeɪbi","uz":"balki","ru":"может быть","ex":["Maybe we can meet tomorrow."],"u":"S02U10"},{"id":"lex.00799","w":"perhaps","pos":"adv","ipa":"pərˈhæps","uz":"ehtimol","ru":"возможно","ex":["Perhaps she is at home."],"u":"S02U10"},{"id":"lex.00800","w":"reserve","pos":"verb","ipa":"rɪˈzɜːrv","uz":"band qilmoq","ru":"резервировать","ex":["I reserved a table for four."],"u":"S02U10"},{"id":"lex.00801","w":"order","pos":"verb","ipa":"ˈɔːrdər","uz":"buyurtma bermoq","ru":"заказывать","ex":["Are you ready to order?"],"u":"S02U10"},{"id":"lex.00802","w":"seat","pos":"noun","ipa":"siːt","uz":"joy, o'rindiq","ru":"место","ex":["Is this seat free?"],"u":"S02U10"},{"id":"lex.00803","w":"meet up","pos":"verb","ipa":"ˌmiːt ˈʌp","uz":"uchrashmoq","ru":"встречаться","ex":["Let's meet up on Saturday."],"u":"S02U10"},{"id":"lex.00804","w":"pick up","pos":"verb","ipa":"ˌpɪk ˈʌp","uz":"olib ketmoq, ko'tarmoq","ru":"забирать","ex":["I'll pick you up at seven."],"u":"S02U10"},{"id":"lex.00805","w":"limit","pos":"noun","ipa":"ˈlɪmɪt","uz":"chegara, me'yor","ru":"предел, лимит","ex":["The speed limit is fifty."],"u":"S02U11"},{"id":"lex.00806","w":"limit","pos":"verb","ipa":"ˈlɪmɪt","uz":"cheklamoq","ru":"ограничивать","ex":["We limit each group to ten."],"u":"S02U11"},{"id":"lex.00807","w":"east","pos":"noun","ipa":"iːst","uz":"sharq","ru":"восток","ex":["The road runs east from the village."],"u":"S02U11"},{"id":"lex.00808","w":"ill","pos":"adj","ipa":"ɪl","uz":"kasal","ru":"больной","ex":["My son is ill today."],"u":"S02U11"},{"id":"lex.00809","w":"sick","pos":"adj","ipa":"sɪk","uz":"kasal","ru":"больной","ex":["I feel sick."],"u":"S02U11"},{"id":"lex.00810","w":"pain","pos":"noun","ipa":"peɪn","uz":"og'riq","ru":"боль","ex":["I have a pain in my back."],"u":"S02U11"},{"id":"lex.00811","w":"headache","pos":"noun","ipa":"ˈhedeɪk","uz":"bosh og'rig'i","ru":"головная боль","ex":["I have a headache."],"u":"S02U11"},{"id":"lex.00812","w":"cold","pos":"noun","ipa":"koʊld","uz":"shamollash","ru":"простуда","ex":["I have a cold."],"u":"S02U11"},{"id":"lex.00813","w":"temperature","pos":"noun","ipa":"ˈtemprətʃər","uz":"harorat","ru":"температура","ex":["He has a high temperature."],"u":"S02U11"},{"id":"lex.00814","w":"medicine","pos":"noun","ipa":"ˈmedəsən","uz":"dori","ru":"лекарство","ex":["Take this medicine three times a day."],"u":"S02U11"},{"id":"lex.00815","w":"fever","pos":"noun","ipa":"ˈfiːvər","uz":"isitma","ru":"жар","ex":["The child has a fever."],"u":"S02U11"},{"id":"lex.00816","w":"cough","pos":"noun","ipa":"kɔːf","uz":"yo'tal","ru":"кашель","ex":["I have a bad cough."],"u":"S02U11"},{"id":"lex.00817","w":"ambulance","pos":"noun","ipa":"ˈæmbjələns","uz":"tez yordam","ru":"скорая помощь","ex":["Call an ambulance!"],"u":"S02U11"},{"id":"lex.00818","w":"rest","pos":"verb","ipa":"rest","uz":"dam olmoq","ru":"отдыхать","ex":["You should rest today."],"u":"S02U11"},{"id":"lex.00819","w":"healthy","pos":"adj","ipa":"ˈhelθi","uz":"sog'lom","ru":"здоровый","ex":["Fruit is healthy."],"u":"S02U11"},{"id":"lex.00820","w":"exercise","pos":"noun","ipa":"ˈeksərsaɪz","uz":"mashq","ru":"упражнение","ex":["Exercise is good for you."],"u":"S02U11"},{"id":"lex.00821","w":"rule","pos":"noun","ipa":"ruːl","uz":"qoida","ru":"правило","ex":["These are the rules of the school."],"u":"S02U11"},{"id":"lex.00822","w":"sign","pos":"noun","ipa":"saɪn","uz":"belgi, e'lon","ru":"знак","ex":["Read the sign on the door."],"u":"S02U11"},{"id":"lex.00823","w":"allowed","pos":"adj","ipa":"əˈlaʊd","uz":"ruxsat etilgan","ru":"разрешено","ex":["Smoking is not allowed here."],"u":"S02U11"},{"id":"lex.00824","w":"entrance","pos":"noun","ipa":"ˈentrəns","uz":"kirish","ru":"вход","ex":["The entrance is on the left."],"u":"S02U11"},{"id":"lex.00825","w":"exit","pos":"noun","ipa":"ˈeɡzɪt","uz":"chiqish","ru":"выход","ex":["Where is the exit?"],"u":"S02U11"},{"id":"lex.00826","w":"danger","pos":"noun","ipa":"ˈdeɪndʒər","uz":"xavf","ru":"опасность","ex":["The sign says 'Danger'."],"u":"S02U11"},{"id":"lex.00827","w":"careful","pos":"adj","ipa":"ˈkerfəl","uz":"ehtiyotkor","ru":"осторожный","ex":["Be careful on the stairs!"],"u":"S02U11"},{"id":"lex.00828","w":"smoke","pos":"verb","ipa":"smoʊk","uz":"chekmoq","ru":"курить","ex":["You mustn't smoke here."],"u":"S02U11"},{"id":"lex.00829","w":"advise","pos":"verb","ipa":"ədˈvaɪz","uz":"maslahat bermoq","ru":"советовать","ex":["The doctor advised me to rest."],"u":"S02U11"},{"id":"lex.00830","w":"advice","pos":"noun","ipa":"ədˈvaɪs","uz":"maslahat","ru":"совет","ex":["Thank you for your advice."],"u":"S02U11"},{"id":"lex.00831","w":"recommend","pos":"verb","ipa":"ˌrekəˈmend","uz":"tavsiya qilmoq","ru":"рекомендовать","ex":["I recommend this restaurant."],"u":"S02U11"},{"id":"lex.00832","w":"necessary","pos":"adj","ipa":"ˈnesəseri","uz":"zarur","ru":"необходимый","ex":["It isn't necessary to book."],"u":"S02U11"},{"id":"lex.00833","w":"law","pos":"noun","ipa":"lɔː","uz":"qonun","ru":"закон","ex":["It's against the law."],"u":"S02U11"},{"id":"lex.00834","w":"police","pos":"noun","ipa":"pəˈliːs","uz":"politsiya","ru":"полиция","ex":["Call the police!"],"u":"S02U11"},{"id":"lex.00835","w":"turn off","pos":"verb","ipa":"ˌtɜːrn ˈɔːf","uz":"o'chirmoq","ru":"выключать","ex":["Turn off your phone, please."],"u":"S02U11"},{"id":"lex.00836","w":"turn on","pos":"verb","ipa":"ˌtɜːrn ˈɑːn","uz":"yoqmoq","ru":"включать","ex":["Turn on the light, please."],"u":"S02U11"},{"id":"lex.00837","w":"diet","pos":"noun","ipa":"ˈdaɪət","uz":"parhez, ovqatlanish","ru":"диета","ex":["A healthy diet is important."],"u":"S02U11"},{"id":"lex.00838","w":"salt","pos":"noun","ipa":"sɔːlt","uz":"tuz","ru":"соль","ex":["Pass the salt, please."],"u":"S02U11"},{"id":"lex.00839","w":"must","pos":"modal","ipa":"mʌst","uz":"shart","ru":"должен","ex":["You must wear a seatbelt."],"u":"S02U11"},{"id":"lex.00840","w":"should","pos":"modal","ipa":"ʃʊd","uz":"kerak (maslahat)","ru":"следует","ex":["You should see a doctor."],"u":"S02U11"},{"id":"lex.00841","w":"have to","pos":"phrase","ipa":"ˈhæf tuː","uz":"majbur bo'lmoq","ru":"должен","ex":["I have to work on Saturday."],"u":"S02U11"},{"id":"lex.00842","w":"west","pos":"noun","ipa":"west","uz":"g'arb","ru":"запад","ex":["The wind comes from the west."],"u":"S02U12"},{"id":"lex.00843","w":"at least","pos":"phrase","ipa":"ət ˈliːst","uz":"hech bo'lmaganda","ru":"по крайней мере","ex":["It costs at least twenty."],"u":"S02U12"},{"id":"lex.00844","w":"even","pos":"adv","ipa":"ˈiːvən","uz":"hatto","ru":"даже","ex":["Even my sister came."],"u":"S02U12"},{"id":"lex.00845","w":"desert","pos":"noun","ipa":"ˈdezərt","uz":"cho'l","ru":"пустыня","ex":["The Kyzylkum is a big desert."],"u":"S02U12"},{"id":"lex.00846","w":"forest","pos":"noun","ipa":"ˈfɔːrɪst","uz":"o'rmon","ru":"лес","ex":["We walked in the forest."],"u":"S02U12"},{"id":"lex.00847","w":"village","pos":"noun","ipa":"ˈvɪlɪdʒ","uz":"qishloq","ru":"деревня","ex":["My grandparents live in a village."],"u":"S02U12"},{"id":"lex.00848","w":"town","pos":"noun","ipa":"taʊn","uz":"shaharcha","ru":"городок","ex":["I grew up in a small town."],"u":"S02U12"},{"id":"lex.00849","w":"capital","pos":"noun","ipa":"ˈkæpɪtəl","uz":"poytaxt","ru":"столица","ex":["Tashkent is the capital of Uzbekistan."],"u":"S02U12"},{"id":"lex.00850","w":"population","pos":"noun","ipa":"ˌpɑːpjəˈleɪʃən","uz":"aholi","ru":"население","ex":["The population of Tashkent is about three million."],"u":"S02U12"},{"id":"lex.00851","w":"area","pos":"noun","ipa":"ˈeriə","uz":"hudud","ru":"область","ex":["This area is very quiet."],"u":"S02U12"},{"id":"lex.00852","w":"world","pos":"noun","ipa":"wɜːrld","uz":"dunyo","ru":"мир","ex":["It's the biggest city in the world."],"u":"S02U12"},{"id":"lex.00853","w":"high","pos":"adj","ipa":"haɪ","uz":"baland","ru":"высокий","ex":["The mountains are very high."],"u":"S02U12"},{"id":"lex.00854","w":"low","pos":"adj","ipa":"loʊ","uz":"past","ru":"низкий","ex":["The prices are low here."],"u":"S02U12"},{"id":"lex.00855","w":"wide","pos":"adj","ipa":"waɪd","uz":"keng","ru":"широкий","ex":["The river is very wide."],"u":"S02U12"},{"id":"lex.00856","w":"deep","pos":"adj","ipa":"diːp","uz":"chuqur","ru":"глубокий","ex":["The lake is very deep."],"u":"S02U12"},{"id":"lex.00857","w":"heavy","pos":"adj","ipa":"ˈhevi","uz":"og'ir","ru":"тяжёлый","ex":["This bag is very heavy."],"u":"S02U12"},{"id":"lex.00858","w":"light","pos":"adj","ipa":"laɪt","uz":"yengil","ru":"лёгкий","ex":["My bag is light."],"u":"S02U12"},{"id":"lex.00859","w":"popular","pos":"adj","ipa":"ˈpɑːpjələr","uz":"mashhur, ommabop","ru":"популярный","ex":["Football is very popular here."],"u":"S02U12"},{"id":"lex.00860","w":"famous","pos":"adj","ipa":"ˈfeɪməs","uz":"mashhur","ru":"известный","ex":["Samarkand is famous for the Registan."],"u":"S02U12"},{"id":"lex.00861","w":"crowded","pos":"adj","ipa":"ˈkraʊdɪd","uz":"gavjum","ru":"переполненный","ex":["The bus was very crowded."],"u":"S02U12"},{"id":"lex.00862","w":"traditional","pos":"adj","ipa":"trəˈdɪʃənəl","uz":"an'anaviy","ru":"традиционный","ex":["This is traditional Uzbek food."],"u":"S02U12"},{"id":"lex.00863","w":"than","pos":"conj","ipa":"ðæn","uz":"-dan (qiyoslashda)","ru":"чем","ex":["Samarkand is older than Tashkent."],"u":"S02U12"},{"id":"lex.00864","w":"as","pos":"conj","ipa":"æz","uz":"-day, kabi","ru":"как","ex":["Bukhara is not as big as Tashkent."],"u":"S02U12"},{"id":"lex.00865","w":"more","pos":"det","ipa":"mɔːr","uz":"ko'proq","ru":"больше","ex":["This is more expensive."],"u":"S02U12"},{"id":"lex.00866","w":"most","pos":"det","ipa":"moʊst","uz":"eng ko'p","ru":"самый","ex":["This is the most beautiful city."],"u":"S02U12"},{"id":"lex.00867","w":"less","pos":"det","ipa":"les","uz":"kamroq","ru":"меньше","ex":["I have less money than you."],"u":"S02U12"},{"id":"lex.00868","w":"same","pos":"adj","ipa":"seɪm","uz":"bir xil","ru":"такой же","ex":["We are the same age."],"u":"S02U12"},{"id":"lex.00869","w":"different","pos":"adj","ipa":"ˈdɪfrənt","uz":"boshqacha","ru":"другой","ex":["My city is different from yours."],"u":"S02U12"},{"id":"lex.00870","w":"kilometre","pos":"noun","ipa":"kɪˈlɑːmɪtər","uz":"kilometr","ru":"километр","ex":["It's ten kilometres from here."],"u":"S02U12"},{"id":"lex.00871","w":"metre","pos":"noun","ipa":"ˈmiːtər","uz":"metr","ru":"метр","ex":["The room is four metres long."],"u":"S02U12"},{"id":"lex.00872","w":"degree","pos":"noun","ipa":"dɪˈɡriː","uz":"gradus; diplom","ru":"градус; степень","ex":["It's thirty degrees today."],"u":"S02U12"},{"id":"lex.00873","w":"north","pos":"noun","ipa":"nɔːrθ","uz":"shimol","ru":"север","ex":["Nukus is in the north of Uzbekistan."],"u":"S02U12"},{"id":"lex.00874","w":"south","pos":"noun","ipa":"saʊθ","uz":"janub","ru":"юг","ex":["Termez is in the south."],"u":"S02U12"},{"id":"lex.00875","w":"lead","pos":"verb","ipa":"liːd","uz":"boshlab bormoq; boshqarmoq","ru":"вести; возглавлять","ex":["She leads the team."],"u":"S03U01"},{"id":"lex.00876","w":"sightseeing","pos":"noun","ipa":"ˈsaɪtsiːɪŋ","uz":"sayohat qilib joylarni ko'rish","ru":"осмотр достопримечательностей","ex":["We went sightseeing all morning."],"u":"S03U01"},{"id":"lex.00877","w":"destination","pos":"noun","ipa":"ˌdestɪˈneɪʃən","uz":"manzil","ru":"пункт назначения","ex":["Our destination is Samarkand."],"u":"S03U01"},{"id":"lex.00878","w":"backpack","pos":"noun","ipa":"ˈbækpæk","uz":"ryukzak","ru":"рюкзак","ex":["My backpack is very heavy."],"u":"S03U01"},{"id":"lex.00879","w":"currency","pos":"noun","ipa":"ˈkɜːrənsi","uz":"valyuta","ru":"валюта","ex":["What currency do they use there?"],"u":"S03U01"},{"id":"lex.00880","w":"exchange","pos":"verb","ipa":"ɪksˈtʃeɪndʒ","uz":"almashtirmoq","ru":"обменять","ex":["Where can I exchange money?"],"u":"S03U01"},{"id":"lex.00881","w":"landmark","pos":"noun","ipa":"ˈlændmɑːrk","uz":"mashhur joy","ru":"достопримечательность","ex":["The tower is a famous landmark."],"u":"S03U01"},{"id":"lex.00882","w":"cathedral","pos":"noun","ipa":"kəˈθiːdrəl","uz":"katta cherkov","ru":"собор","ex":["The cathedral is over 500 years old."],"u":"S03U01"},{"id":"lex.00883","w":"monument","pos":"noun","ipa":"ˈmɑːnjumənt","uz":"yodgorlik","ru":"памятник","ex":["There is a monument in the square."],"u":"S03U01"},{"id":"lex.00884","w":"ferry","pos":"noun","ipa":"ˈferi","uz":"parom","ru":"паром","ex":["We crossed the river by ferry."],"u":"S03U01"},{"id":"lex.00885","w":"cruise","pos":"noun","ipa":"kruːz","uz":"kema sayohati","ru":"круиз","ex":["They went on a cruise last summer."],"u":"S03U01"},{"id":"lex.00886","w":"voyage","pos":"noun","ipa":"ˈvɔɪɪdʒ","uz":"uzoq dengiz safari","ru":"плавание","ex":["The voyage took two weeks."],"u":"S03U01"},{"id":"lex.00887","w":"terminal","pos":"noun","ipa":"ˈtɜːrmɪnəl","uz":"terminal","ru":"терминал","ex":["Our flight leaves from Terminal 2."],"u":"S03U01"},{"id":"lex.00888","w":"aisle","pos":"noun","ipa":"aɪl","uz":"yo'lak","ru":"проход","ex":["I prefer an aisle seat."],"u":"S03U01"},{"id":"lex.00889","w":"harbour","pos":"noun","ipa":"ˈhɑːrbər","uz":"port, bandargoh","ru":"гавань","ex":["The boats are in the harbour."],"u":"S03U01"},{"id":"lex.00890","w":"port","pos":"noun","ipa":"pɔːrt","uz":"port","ru":"порт","ex":["The ship arrived at the port."],"u":"S03U01"},{"id":"lex.00891","w":"lane","pos":"noun","ipa":"leɪn","uz":"tor ko'cha, yo'lak","ru":"переулок, полоса","ex":["Their house is in a narrow lane."],"u":"S03U01"},{"id":"lex.00892","w":"arrival","pos":"noun","ipa":"əˈraɪvəl","uz":"kelish","ru":"прибытие","ex":["What time is your arrival?"],"u":"S03U01"},{"id":"lex.00893","w":"departure","pos":"noun","ipa":"dɪˈpɑːrtʃər","uz":"jo'nash","ru":"отправление","ex":["The departure is at nine."],"u":"S03U01"},{"id":"lex.00894","w":"platform","pos":"noun","ipa":"ˈplætfɔːrm","uz":"perron","ru":"платформа","ex":["The train leaves from platform three."],"u":"S03U01"},{"id":"lex.00895","w":"gate","pos":"noun","ipa":"ɡeɪt","uz":"chiqish (aeroportda)","ru":"выход","ex":["Go to gate twelve."],"u":"S03U01"},{"id":"lex.00896","w":"delay","pos":"noun","ipa":"dɪˈleɪ","uz":"kechikish","ru":"задержка","ex":["There is a two-hour delay."],"u":"S03U01"},{"id":"lex.00897","w":"timetable","pos":"noun","ipa":"ˈtaɪmteɪbəl","uz":"jadval","ru":"расписание","ex":["Look at the timetable."],"u":"S03U01"},{"id":"lex.00898","w":"return","pos":"adj","ipa":"rɪˈtɜːrn","uz":"borib-kelish","ru":"туда и обратно","ex":["Two return tickets, please."],"u":"S03U01"},{"id":"lex.00899","w":"passenger","pos":"noun","ipa":"ˈpæsɪndʒər","uz":"yo'lovchi","ru":"пассажир","ex":["All passengers must show a ticket."],"u":"S03U01"},{"id":"lex.00900","w":"pack","pos":"verb","ipa":"pæk","uz":"yig'ishtirmoq","ru":"упаковывать","ex":["I need to pack my bag."],"u":"S03U01"},{"id":"lex.00901","w":"miss","pos":"verb","ipa":"mɪs","uz":"kechikmoq, sog'inmoq","ru":"опоздать, скучать","ex":["I missed the bus."],"u":"S03U01"},{"id":"lex.00902","w":"land","pos":"verb","ipa":"lænd","uz":"qo'nmoq","ru":"приземляться","ex":["The plane lands at six."],"u":"S03U01"},{"id":"lex.00903","w":"check in","pos":"verb","ipa":"ˌtʃek ˈɪn","uz":"ro'yxatdan o'tmoq","ru":"регистрироваться","ex":["You must check in two hours before."],"u":"S03U01"},{"id":"lex.00904","w":"customs","pos":"noun","ipa":"ˈkʌstəmz","uz":"bojxona","ru":"таможня","ex":["We went through customs quickly."],"u":"S03U01"},{"id":"lex.00905","w":"visa","pos":"noun","ipa":"ˈviːzə","uz":"viza","ru":"виза","ex":["Do I need a visa?"],"u":"S03U01"},{"id":"lex.00906","w":"insurance","pos":"noun","ipa":"ɪnˈʃʊrəns","uz":"sug'urta","ru":"страховка","ex":["Travel insurance is important."],"u":"S03U01"},{"id":"lex.00907","w":"direct","pos":"adj","ipa":"dəˈrekt","uz":"to'g'ridan-to'g'ri","ru":"прямой","ex":["Is there a direct flight?"],"u":"S03U01"},{"id":"lex.00908","w":"local","pos":"adj","ipa":"ˈloʊkəl","uz":"mahalliy","ru":"местный","ex":["We ate at a local restaurant."],"u":"S03U01"},{"id":"lex.00909","w":"nearby","pos":"adj","ipa":"ˌnɪrˈbaɪ","uz":"yaqin atrofdagi","ru":"поблизости","ex":["There is a shop nearby."],"u":"S03U01"},{"id":"lex.00910","w":"depart","pos":"verb","ipa":"dɪˈpɑːrt","uz":"jo'namoq","ru":"отправляться","ex":["The train departs at nine."],"u":"S03U01"},{"id":"lex.00911","w":"announcement","pos":"noun","ipa":"əˈnaʊnsmənt","uz":"e'lon","ru":"объявление","ex":["Did you hear the announcement?"],"u":"S03U01"},{"id":"lex.00912","w":"cover","pos":"verb","ipa":"ˈkʌvər","uz":"yopmoq; qamrab olmoq","ru":"покрывать; охватывать","ex":["Cover the food, please."],"u":"S03U02"},{"id":"lex.00913","w":"cover","pos":"noun","ipa":"ˈkʌvər","uz":"muqova; qopqoq","ru":"обложка; чехол","ex":["The book has a red cover."],"u":"S03U02"},{"id":"lex.00914","w":"edge","pos":"noun","ipa":"edʒ","uz":"chekka, qirra","ru":"край","ex":["Do not stand near the edge."],"u":"S03U02"},{"id":"lex.00915","w":"directly","pos":"adv","ipa":"dəˈrektli","uz":"to'g'ridan-to'g'ri","ru":"напрямую","ex":["Write to her directly."],"u":"S03U02"},{"id":"lex.00916","w":"space","pos":"noun","ipa":"speɪs","uz":"joy, bo'sh maydon","ru":"место, пространство","ex":["There is space for two more chairs."],"u":"S03U02"},{"id":"lex.00917","w":"freckle","pos":"noun","ipa":"ˈfrekəl","uz":"sepkil","ru":"веснушка","ex":["She has freckles on her nose."],"u":"S03U02"},{"id":"lex.00918","w":"wrinkle","pos":"noun","ipa":"ˈrɪŋkəl","uz":"ajin","ru":"морщина","ex":["He has a few wrinkles around his eyes."],"u":"S03U02"},{"id":"lex.00919","w":"chubby","pos":"adj","ipa":"ˈtʃʌbi","uz":"to'ladan kelgan","ru":"пухлый","ex":["The baby has chubby cheeks."],"u":"S03U02"},{"id":"lex.00920","w":"ambitious","pos":"adj","ipa":"æmˈbɪʃəs","uz":"intiluvchan","ru":"амбициозный","ex":["She is very ambitious."],"u":"S03U02"},{"id":"lex.00921","w":"jealous","pos":"adj","ipa":"ˈdʒeləs","uz":"rashkchi, hasadgo'y","ru":"ревнивый, завистливый","ex":["Don't be jealous of your brother."],"u":"S03U02"},{"id":"lex.00922","w":"stubborn","pos":"adj","ipa":"ˈstʌbərn","uz":"o'jar","ru":"упрямый","ex":["My father is a stubborn man."],"u":"S03U02"},{"id":"lex.00923","w":"sociable","pos":"adj","ipa":"ˈsoʊʃəbəl","uz":"kirishimli","ru":"общительный","ex":["He is sociable and has many friends."],"u":"S03U02"},{"id":"lex.00924","w":"strict","pos":"adj","ipa":"strɪkt","uz":"qattiqqo'l","ru":"строгий","ex":["Our teacher is strict but fair."],"u":"S03U02"},{"id":"lex.00925","w":"gentle","pos":"adj","ipa":"ˈdʒentəl","uz":"muloyim","ru":"нежный, мягкий","ex":["He has a gentle voice."],"u":"S03U02"},{"id":"lex.00926","w":"charming","pos":"adj","ipa":"ˈtʃɑːrmɪŋ","uz":"maftunkor","ru":"очаровательный","ex":["Her grandmother is charming."],"u":"S03U02"},{"id":"lex.00927","w":"lively","pos":"adj","ipa":"ˈlaɪvli","uz":"jonli, harakatchan","ru":"живой","ex":["She is a lively child."],"u":"S03U02"},{"id":"lex.00928","w":"calm","pos":"adj","ipa":"kɑːm","uz":"xotirjam","ru":"спокойный","ex":["Stay calm and listen."],"u":"S03U02"},{"id":"lex.00929","w":"mature","pos":"adj","ipa":"məˈtʃʊr","uz":"yetuk","ru":"зрелый","ex":["She is very mature for her age."],"u":"S03U02"},{"id":"lex.00930","w":"elegant","pos":"adj","ipa":"ˈelɪɡənt","uz":"nafis","ru":"элегантный","ex":["She wore an elegant dress."],"u":"S03U02"},{"id":"lex.00931","w":"untidy","pos":"adj","ipa":"ʌnˈtaɪdi","uz":"tartibsiz","ru":"неопрятный","ex":["His room is always untidy."],"u":"S03U02"},{"id":"lex.00932","w":"appearance","pos":"noun","ipa":"əˈpɪrəns","uz":"tashqi ko'rinish","ru":"внешность","ex":["Appearance is not everything."],"u":"S03U02"},{"id":"lex.00933","w":"slim","pos":"adj","ipa":"slɪm","uz":"nozik","ru":"стройный","ex":["She is tall and slim."],"u":"S03U02"},{"id":"lex.00934","w":"overweight","pos":"adj","ipa":"ˌoʊvərˈweɪt","uz":"vazni ortiq","ru":"полный","ex":["The doctor said he is overweight."],"u":"S03U02"},{"id":"lex.00935","w":"blond","pos":"adj","ipa":"blɑːnd","uz":"malla sochli","ru":"светловолосый","ex":["She has blond hair."],"u":"S03U02"},{"id":"lex.00936","w":"straight","pos":"adj","ipa":"streɪt","uz":"tekis (soch)","ru":"прямой","ex":["She has long straight hair."],"u":"S03U02"},{"id":"lex.00937","w":"wavy","pos":"adj","ipa":"ˈweɪvi","uz":"to'lqinsimon","ru":"волнистый","ex":["He has wavy brown hair."],"u":"S03U02"},{"id":"lex.00938","w":"bald","pos":"adj","ipa":"bɔːld","uz":"kal","ru":"лысый","ex":["My uncle is bald."],"u":"S03U02"},{"id":"lex.00939","w":"attractive","pos":"adj","ipa":"əˈtræktɪv","uz":"jozibali","ru":"привлекательный","ex":["She is a very attractive woman."],"u":"S03U02"},{"id":"lex.00940","w":"personality","pos":"noun","ipa":"ˌpɜːrsəˈnæləti","uz":"shaxsiyat","ru":"личность","ex":["He has a strong personality."],"u":"S03U02"},{"id":"lex.00941","w":"confident","pos":"adj","ipa":"ˈkɑːnfɪdənt","uz":"o'ziga ishongan","ru":"уверенный","ex":["She is confident when she speaks."],"u":"S03U02"},{"id":"lex.00942","w":"generous","pos":"adj","ipa":"ˈdʒenərəs","uz":"saxiy","ru":"щедрый","ex":["He is very generous with his time."],"u":"S03U02"},{"id":"lex.00943","w":"mean","pos":"adj","ipa":"miːn","uz":"xasis","ru":"скупой","ex":["Don't be mean with the sugar."],"u":"S03U02"},{"id":"lex.00944","w":"reliable","pos":"adj","ipa":"rɪˈlaɪəbəl","uz":"ishonchli","ru":"надёжный","ex":["He is a reliable worker."],"u":"S03U02"},{"id":"lex.00945","w":"cheerful","pos":"adj","ipa":"ˈtʃɪrfəl","uz":"quvnoq","ru":"весёлый","ex":["She is always cheerful."],"u":"S03U02"},{"id":"lex.00946","w":"selfish","pos":"adj","ipa":"ˈselfɪʃ","uz":"xudbin","ru":"эгоистичный","ex":["That was a selfish thing to do."],"u":"S03U02"},{"id":"lex.00947","w":"talkative","pos":"adj","ipa":"ˈtɔːkətɪv","uz":"gapdon","ru":"разговорчивый","ex":["My sister is very talkative."],"u":"S03U02"},{"id":"lex.00948","w":"look","pos":"noun","ipa":"lʊk","uz":"qarash, ko'rinish","ru":"взгляд","ex":["She gave me a strange look."],"u":"S03U02"},{"id":"lex.00949","w":"similar","pos":"adj","ipa":"ˈsɪmələr","uz":"o'xshash","ru":"похожий","ex":["We have similar ideas."],"u":"S03U02"},{"id":"lex.00950","w":"difference","pos":"noun","ipa":"ˈdɪfrəns","uz":"farq","ru":"разница","ex":["What is the difference?"],"u":"S03U02"},{"id":"lex.00951","w":"describe","pos":"verb","ipa":"dɪˈskraɪb","uz":"tasvirlamoq","ru":"описывать","ex":["Can you describe him?"],"u":"S03U02"},{"id":"lex.00952","w":"suit","pos":"verb","ipa":"suːt","uz":"yarashmoq","ru":"идти (об одежде)","ex":["That colour suits you."],"u":"S03U02"},{"id":"lex.00953","w":"middle","pos":"noun","ipa":"ˈmɪdəl","uz":"o'rta","ru":"середина","ex":["He is in his middle thirties."],"u":"S03U02"},{"id":"lex.00954","w":"twin","pos":"noun","ipa":"twɪn","uz":"egizak","ru":"близнец","ex":["They are twins."],"u":"S03U02"},{"id":"lex.00955","w":"relative","pos":"noun","ipa":"ˈrelətɪv","uz":"qarindosh","ru":"родственник","ex":["We visited our relatives."],"u":"S03U02"},{"id":"lex.00956","w":"couple","pos":"noun","ipa":"ˈkʌpəl","uz":"juftlik; bir nechta","ru":"пара","ex":["They are a nice couple."],"u":"S03U02"},{"id":"lex.00957","w":"addition","pos":"noun","ipa":"əˈdɪʃən","uz":"qo'shimcha; qo'shish","ru":"добавление","ex":["The addition of a room helped."],"u":"S03U03"},{"id":"lex.00958","w":"mark","pos":"verb","ipa":"mɑːrk","uz":"belgilamoq; baholamoq","ru":"отмечать; проверять","ex":["Mark the correct answer."],"u":"S03U03"},{"id":"lex.00959","w":"knock","pos":"verb","ipa":"nɑk","uz":"taqillatmoq","ru":"стучать","ex":["Somebody knocked at the door twice."],"u":"S03U03"},{"id":"lex.00960","w":"vacancy","pos":"noun","ipa":"ˈveɪkənsi","uz":"bo'sh joy","ru":"свободный номер","ex":["Do you have any vacancies tonight?"],"u":"S03U03"},{"id":"lex.00961","w":"reservation","pos":"noun","ipa":"ˌrezərˈveɪʃən","uz":"joy band qilish","ru":"бронь","ex":["I have a reservation for two nights."],"u":"S03U03"},{"id":"lex.00962","w":"checkout","pos":"noun","ipa":"ˈtʃekaʊt","uz":"mehmonxonadan chiqish vaqti","ru":"выезд из отеля","ex":["Checkout is at eleven o'clock."],"u":"S03U03"},{"id":"lex.00963","w":"corridor","pos":"noun","ipa":"ˈkɔːrɪdɔːr","uz":"koridor","ru":"коридор","ex":["My room is at the end of the corridor."],"u":"S03U03"},{"id":"lex.00964","w":"laundry","pos":"noun","ipa":"ˈlɔːndri","uz":"kir yuvish","ru":"стирка, прачечная","ex":["Is there a laundry service?"],"u":"S03U03"},{"id":"lex.00965","w":"housekeeping","pos":"noun","ipa":"ˈhaʊskiːpɪŋ","uz":"xona tozalash xizmati","ru":"уборка номеров","ex":["Housekeeping cleans the room every day."],"u":"S03U03"},{"id":"lex.00966","w":"wardrobe","pos":"noun","ipa":"ˈwɔːrdroʊb","uz":"shkaf","ru":"шкаф","ex":["Your clothes are in the wardrobe."],"u":"S03U03"},{"id":"lex.00967","w":"kettle","pos":"noun","ipa":"ˈketəl","uz":"choynak (elektr)","ru":"чайник","ex":["There is a kettle in the room."],"u":"S03U03"},{"id":"lex.00968","w":"mattress","pos":"noun","ipa":"ˈmætrəs","uz":"matras","ru":"матрас","ex":["The mattress is too hard."],"u":"S03U03"},{"id":"lex.00969","w":"leak","pos":"verb","ipa":"liːk","uz":"oqmoq","ru":"протекать","ex":["The tap is leaking."],"u":"S03U03"},{"id":"lex.00970","w":"doorbell","pos":"noun","ipa":"ˈdɔːrbel","uz":"eshik qo'ng'irog'i","ru":"дверной звонок","ex":["The doorbell rang twice."],"u":"S03U03"},{"id":"lex.00971","w":"inclusive","pos":"adj","ipa":"ɪnˈkluːsɪv","uz":"hamma narsa kiritilgan","ru":"включённый","ex":["The price is inclusive of breakfast."],"u":"S03U03"},{"id":"lex.00972","w":"spacious","pos":"adj","ipa":"ˈspeɪʃəs","uz":"keng","ru":"просторный","ex":["The room is bright and spacious."],"u":"S03U03"},{"id":"lex.00973","w":"cosy","pos":"adj","ipa":"ˈkoʊzi","uz":"shinam","ru":"уютный","ex":["It is a small but cosy room."],"u":"S03U03"},{"id":"lex.00974","w":"reception","pos":"noun","ipa":"rɪˈsepʃən","uz":"qabulxona","ru":"ресепшн","ex":["Ask at reception."],"u":"S03U03"},{"id":"lex.00975","w":"double","pos":"adj","ipa":"ˈdʌbəl","uz":"ikki kishilik","ru":"двухместный","ex":["I'd like a double room."],"u":"S03U03"},{"id":"lex.00976","w":"lift","pos":"noun","ipa":"lɪft","uz":"lift","ru":"лифт","ex":["The lift is over there."],"u":"S03U03"},{"id":"lex.00977","w":"towel","pos":"noun","ipa":"ˈtaʊəl","uz":"sochiq","ru":"полотенце","ex":["Could I have another towel?"],"u":"S03U03"},{"id":"lex.00978","w":"blanket","pos":"noun","ipa":"ˈblæŋkɪt","uz":"adyol","ru":"одеяло","ex":["Could I have an extra blanket?"],"u":"S03U03"},{"id":"lex.00979","w":"pillow","pos":"noun","ipa":"ˈpɪloʊ","uz":"yostiq","ru":"подушка","ex":["The pillow is too soft."],"u":"S03U03"},{"id":"lex.00980","w":"noise","pos":"noun","ipa":"nɔɪz","uz":"shovqin","ru":"шум","ex":["There is a lot of noise outside."],"u":"S03U03"},{"id":"lex.00981","w":"air conditioning","pos":"noun","ipa":"ˈer kənˌdɪʃənɪŋ","uz":"konditsioner","ru":"кондиционер","ex":["The air conditioning is not working."],"u":"S03U03"},{"id":"lex.00982","w":"key card","pos":"noun","ipa":"ˈkiː kɑːrd","uz":"kalit karta","ru":"ключ-карта","ex":["Here is your key card."],"u":"S03U03"},{"id":"lex.00983","w":"complain","pos":"verb","ipa":"kəmˈpleɪn","uz":"shikoyat qilmoq","ru":"жаловаться","ex":["I want to complain about the noise."],"u":"S03U03"},{"id":"lex.00984","w":"complaint","pos":"noun","ipa":"kəmˈpleɪnt","uz":"shikoyat","ru":"жалоба","ex":["I have a complaint about my room."],"u":"S03U03"},{"id":"lex.00985","w":"apologise","pos":"verb","ipa":"əˈpɑːlədʒaɪz","uz":"uzr so'ramoq","ru":"извиняться","ex":["I apologise for the delay."],"u":"S03U03"},{"id":"lex.00986","w":"broken","pos":"adj","ipa":"ˈbroʊkən","uz":"buzilgan","ru":"сломанный","ex":["The window is broken."],"u":"S03U03"},{"id":"lex.00987","w":"fix","pos":"verb","ipa":"fɪks","uz":"tuzatmoq","ru":"чинить","ex":["Can you fix it today?"],"u":"S03U03"},{"id":"lex.00988","w":"immediately","pos":"adv","ipa":"ɪˈmiːdiətli","uz":"darhol","ru":"немедленно","ex":["I will send someone immediately."],"u":"S03U03"},{"id":"lex.00989","w":"extra","pos":"adj","ipa":"ˈekstrə","uz":"qo'shimcha","ru":"дополнительный","ex":["Could I have an extra pillow?"],"u":"S03U03"},{"id":"lex.00990","w":"included","pos":"adj","ipa":"ɪnˈkluːdɪd","uz":"kiritilgan","ru":"включено","ex":["Is breakfast included?"],"u":"S03U03"},{"id":"lex.00991","w":"charge","pos":"noun","ipa":"tʃɑːrdʒ","uz":"to'lov","ru":"плата","ex":["There is a small charge for wifi."],"u":"S03U03"},{"id":"lex.00992","w":"wifi","pos":"noun","ipa":"ˈwaɪfaɪ","uz":"wifi","ru":"вайфай","ex":["What is the wifi password?"],"u":"S03U03"},{"id":"lex.00993","w":"password","pos":"noun","ipa":"ˈpæswɜːrd","uz":"parol","ru":"пароль","ex":["I forgot my password."],"u":"S03U03"},{"id":"lex.00994","w":"view","pos":"noun","ipa":"vjuː","uz":"manzara","ru":"вид","ex":["The room has a beautiful view."],"u":"S03U03"},{"id":"lex.00995","w":"stay","pos":"noun","ipa":"steɪ","uz":"turish","ru":"пребывание","ex":["Enjoy your stay!"],"u":"S03U03"},{"id":"lex.00996","w":"cause","pos":"verb","ipa":"kɔːz","uz":"sabab bo'lmoq","ru":"вызывать","ex":["The rain caused the delay."],"u":"S03U04"},{"id":"lex.00997","w":"ignore","pos":"verb","ipa":"ɪɡˈnɔːr","uz":"e'tiborsiz qoldirmoq","ru":"игнорировать","ex":["He ignored the warning."],"u":"S03U04"},{"id":"lex.00998","w":"especially","pos":"adv","ipa":"ɪˈspeʃəli","uz":"ayniqsa","ru":"особенно","ex":["The road is bad, especially after rain."],"u":"S03U04"},{"id":"lex.00999","w":"breath","pos":"noun","ipa":"breθ","uz":"nafas","ru":"дыхание","ex":["Take a breath before you answer."],"u":"S03U04"},{"id":"lex.01000","w":"stomachache","pos":"noun","ipa":"ˈstʌməkeɪk","uz":"qorin og'rig'i","ru":"боль в животе","ex":["I have a stomachache."],"u":"S03U04"},{"id":"lex.01001","w":"wound","pos":"noun","ipa":"wuːnd","uz":"jarohat","ru":"рана","ex":["The wound is healing well."],"u":"S03U04"},{"id":"lex.01002","w":"bruise","pos":"noun","ipa":"bruːz","uz":"ko'kargan joy","ru":"синяк","ex":["I have a bruise on my leg."],"u":"S03U04"},{"id":"lex.01003","w":"recovery","pos":"noun","ipa":"rɪˈkʌvəri","uz":"tuzalish","ru":"выздоровление","ex":["Her recovery was quick."],"u":"S03U04"},{"id":"lex.01004","w":"allergy","pos":"noun","ipa":"ˈælərdʒi","uz":"allergiya","ru":"аллергия","ex":["I have an allergy to nuts."],"u":"S03U04"},{"id":"lex.01005","w":"infection","pos":"noun","ipa":"ɪnˈfekʃən","uz":"infeksiya","ru":"инфекция","ex":["He has an ear infection."],"u":"S03U04"},{"id":"lex.01006","w":"painkiller","pos":"noun","ipa":"ˈpeɪnkɪlər","uz":"og'riq qoldiruvchi dori","ru":"обезболивающее","ex":["Take a painkiller if it hurts."],"u":"S03U04"},{"id":"lex.01007","w":"chemist","pos":"noun","ipa":"ˈkemɪst","uz":"dorixona, dorixonachi","ru":"аптека, аптекарь","ex":["The chemist is opposite the bank."],"u":"S03U04"},{"id":"lex.01008","w":"bandage","pos":"noun","ipa":"ˈbændɪdʒ","uz":"bint","ru":"бинт","ex":["Put a bandage on your finger."],"u":"S03U04"},{"id":"lex.01009","w":"surgery","pos":"noun","ipa":"ˈsɜːrdʒəri","uz":"operatsiya","ru":"операция","ex":["He needs surgery on his knee."],"u":"S03U04"},{"id":"lex.01010","w":"vitamin","pos":"noun","ipa":"ˈvaɪtəmɪn","uz":"vitamin","ru":"витамин","ex":["Oranges are full of vitamin C."],"u":"S03U04"},{"id":"lex.01011","w":"swollen","pos":"adj","ipa":"ˈswoʊlən","uz":"shishgan","ru":"опухший","ex":["My ankle is swollen."],"u":"S03U04"},{"id":"lex.01012","w":"dizzy","pos":"adj","ipa":"ˈdɪzi","uz":"boshi aylanayotgan","ru":"кружится голова","ex":["I feel dizzy when I stand up."],"u":"S03U04"},{"id":"lex.01013","w":"exhausted","pos":"adj","ipa":"ɪɡˈzɔːstɪd","uz":"charchagan","ru":"измотанный","ex":["I am exhausted after the trip."],"u":"S03U04"},{"id":"lex.01014","w":"health","pos":"noun","ipa":"helθ","uz":"salomatlik","ru":"здоровье","ex":["Health is more important than money."],"u":"S03U04"},{"id":"lex.01015","w":"illness","pos":"noun","ipa":"ˈɪlnəs","uz":"kasallik","ru":"болезнь","ex":["It is a common illness."],"u":"S03U04"},{"id":"lex.01016","w":"symptom","pos":"noun","ipa":"ˈsɪmptəm","uz":"alomat","ru":"симптом","ex":["What are your symptoms?"],"u":"S03U04"},{"id":"lex.01017","w":"throat","pos":"noun","ipa":"θroʊt","uz":"tomoq","ru":"горло","ex":["I have a sore throat."],"u":"S03U04"},{"id":"lex.01018","w":"stomach","pos":"noun","ipa":"ˈstʌmək","uz":"oshqozon","ru":"желудок","ex":["I have a stomach ache."],"u":"S03U04"},{"id":"lex.01019","w":"back","pos":"noun","ipa":"bæk","uz":"bel, orqa","ru":"спина","ex":["My back hurts."],"u":"S03U04"},{"id":"lex.01020","w":"sore","pos":"adj","ipa":"sɔːr","uz":"og'riyotgan","ru":"больной","ex":["I have a sore throat."],"u":"S03U04"},{"id":"lex.01021","w":"painful","pos":"adj","ipa":"ˈpeɪnfəl","uz":"og'riqli","ru":"болезненный","ex":["Is 