16"},{"id":"lex.02752","w":"scream","pos":"verb","ipa":"skriːm","uz":"baqirmoq, chinqirmoq","ru":"кричать","ex":["She screamed with surprise."],"u":"S05U16"},{"id":"lex.02753","w":"sigh","pos":"verb","ipa":"saɪ","uz":"xo'rsinmoq","ru":"вздыхать","ex":["He sighed and sat down."],"u":"S05U16"},{"id":"lex.02754","w":"giggle","pos":"verb","ipa":"ˈɡɪɡəl","uz":"pixillab kulmoq","ru":"хихикать","ex":["The children giggled."],"u":"S05U16"},{"id":"lex.02755","w":"shrug","pos":"verb","ipa":"ʃrʌɡ","uz":"yelka qisish","ru":"пожимать плечами","ex":["He just shrugged."],"u":"S05U16"},{"id":"lex.02756","w":"pitch","pos":"noun","ipa":"pɪtʃ","uz":"ovoz balandligi","ru":"высота голоса","ex":["Her voice rose in pitch."],"u":"S05U16"},{"id":"lex.02757","w":"volume","pos":"noun","ipa":"ˈvɑːljuːm","uz":"ovoz balandligi","ru":"громкость","ex":["Turn the volume down."],"u":"S05U16"},{"id":"lex.02758","w":"speed","pos":"noun","ipa":"spiːd","uz":"tezlik","ru":"скорость","ex":["He speaks at great speed."],"u":"S05U16"},{"id":"lex.02759","w":"greeting","pos":"noun","ipa":"ˈɡriːtɪŋ","uz":"salomlashish","ru":"приветствие","ex":["He raised a hand in greeting."],"u":"S05U16"},{"id":"lex.02760","w":"congratulation","pos":"noun","ipa":"kənˌɡrætʃuˈleɪʃən","uz":"tabrik","ru":"поздравление","ex":["Congratulations on your exam!"],"u":"S05U16"},{"id":"lex.02761","w":"intonation","pos":"noun","ipa":"ˌɪntəˈneɪʃən","uz":"ohang","ru":"интонация","ex":["Her intonation rose at the end."],"u":"S05U16"},{"id":"lex.02762","w":"banter","pos":"noun","ipa":"ˈbæntər","uz":"do'stona hazillashish","ru":"добродушная шутка","ex":["There was friendly banter all evening."],"u":"S05U16"},{"id":"lex.02763","w":"friendliness","pos":"noun","ipa":"ˈfrendlinəs","uz":"do'stonalik","ru":"дружелюбие","ex":["Her friendliness put me at ease."],"u":"S05U16"},{"id":"lex.02764","w":"wording","pos":"noun","ipa":"ˈwɜːrdɪŋ","uz":"ifoda, matn tuzilishi","ru":"формулировка","ex":["The wording of the rule is unclear."],"u":"S05U16"},{"id":"le