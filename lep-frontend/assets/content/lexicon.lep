:"S02U03"},{"id":"lex.00518","w":"pink","pos":"adj","ipa":"pɪŋk","uz":"pushti","ru":"розовый","ex":["My daughter likes pink."],"u":"S02U03"},{"id":"lex.00519","w":"price","pos":"noun","ipa":"praɪs","uz":"narx","ru":"цена","ex":["What's the price?"],"u":"S02U03"},{"id":"lex.00520","w":"cheap","pos":"adj","ipa":"tʃiːp","uz":"arzon","ru":"дешёвый","ex":["This shop is cheap."],"u":"S02U03"},{"id":"lex.00521","w":"expensive","pos":"adj","ipa":"ɪkˈspensɪv","uz":"qimmat","ru":"дорогой","ex":["That car is very expensive."],"u":"S02U03"},{"id":"lex.00522","w":"pay","pos":"verb","ipa":"peɪ","uz":"to'lamoq","ru":"платить","ex":["Can I pay by card?"],"u":"S02U03"},{"id":"lex.00523","w":"cost","pos":"verb","ipa":"kɔːst","uz":"turmoq (narx)","ru":"стоить","ex":["How much does it cost?"],"u":"S02U03"},{"id":"lex.00524","w":"change","pos":"noun","ipa":"tʃeɪndʒ","uz":"qaytim","ru":"сдача","ex":["Here is your change."],"u":"S02U03"},{"id":"lex.00525","w":"size","pos":"noun","ipa":"saɪz","uz":"o'lcham","ru":"размер","ex":["What size are you?"],"u":"S02U03"},{"id":"lex.00526","w":"try on","pos":"verb","ipa":"ˌtraɪ ˈɑːn","uz":"kiyib ko'rmoq","ru":"примерять","ex":["Can I try it on?"],"u":"S02U03"},{"id":"lex.00527","w":"customer","pos":"noun","ipa":"ˈkʌstəmər","uz":"xaridor","ru":"покупатель","ex":["The shop has a lot of customers."],"u":"S02U03"},{"id":"lex.00528","w":"receipt","pos":"noun","ipa":"rɪˈsiːt","uz":"chek","ru":"чек","ex":["Here is your receipt."],"u":"S02U03"},{"id":"lex.00529","w":"sweater","pos":"noun","ipa":"ˈswetər","uz":"sviter","ru":"свитер","ex":["Wear a sweater, it's cold."],"u":"S02U03"},{"id":"lex.00530","w":"suit","pos":"noun","ipa":"suːt","uz":"kostyum","ru":"костюм","ex":["He wears a suit to work."],"u":"S02U03"},{"id":"lex.00531","w":"tie","pos":"noun","ipa":"taɪ","uz":"galstuk","ru":"галстук","ex":["He is wearing a blue tie."],"u":"S02U03"},{"id":"lex.00532","w":"scarf","pos":"noun","ipa":"skɑːrf","uz":"ro'mol, sharf","ru":"шарф","ex":["She wears a scarf in 