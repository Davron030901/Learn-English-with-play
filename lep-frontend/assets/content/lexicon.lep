":"S03U06"},{"id":"lex.01077","w":"difficulty","pos":"noun","ipa":"ˈdɪfɪkəlti","uz":"qiyinchilik","ru":"трудность","ex":["The only difficulty is the date."],"u":"S03U06"},{"id":"lex.01078","w":"hang","pos":"verb","ipa":"hæŋ","uz":"osmoq","ru":"вешать","ex":["Hang your coat by the door."],"u":"S03U06"},{"id":"lex.01079","w":"argue","pos":"verb","ipa":"ˈɑːrɡjuː","uz":"bahslashmoq","ru":"спорить","ex":["They argued about the price."],"u":"S03U06"},{"id":"lex.01080","w":"laptop","pos":"noun","ipa":"ˈlæptɑːp","uz":"noutbuk","ru":"ноутбук","ex":["My laptop is very slow."],"u":"S03U06"},{"id":"lex.01081","w":"tablet","pos":"noun","ipa":"ˈtæblət","uz":"planshet","ru":"планшет","ex":["He reads the news on a tablet."],"u":"S03U06"},{"id":"lex.01082","w":"printer","pos":"noun","ipa":"ˈprɪntər","uz":"printer","ru":"принтер","ex":["The printer is out of paper."],"u":"S03U06"},{"id":"lex.01083","w":"socket","pos":"noun","ipa":"ˈsɑːkɪt","uz":"rozetka","ru":"розетка","ex":["There is a socket behind the desk."],"u":"S03U06"},{"id":"lex.01084","w":"cable","pos":"noun","ipa":"ˈkeɪbəl","uz":"kabel","ru":"кабель","ex":["I need a longer cable."],"u":"S03U06"},{"id":"lex.01085","w":"settings","pos":"noun","ipa":"ˈsetɪŋz","uz":"sozlamalar","ru":"настройки","ex":["Open the settings and change the language."],"u":"S03U06"},{"id":"lex.01086","w":"folder","pos":"noun","ipa":"ˈfoʊldər","uz":"papka","ru":"папка","ex":["Save the file in this folder."],"u":"S03U06"},{"id":"lex.01087","w":"software","pos":"noun","ipa":"ˈsɔːftwer","uz":"dastur ta'minoti","ru":"программное обеспечение","ex":["The software is free."],"u":"S03U06"},{"id":"lex.01088","w":"update","pos":"verb","ipa":"ʌpˈdeɪt","uz":"yangilamoq","ru":"обновлять","ex":["You should update the app."],"u":"S03U06"},{"id":"lex.01089","w":"install","pos":"verb","ipa":"ɪnˈstɔːl","uz":"o'rnatmoq","ru":"установить","ex":["Install the program first."],"u":"S03U06"},{"id":"lex.01090","w":"wireless","pos":"adj","ipa":"ˈwaɪərləs","uz":"simsiz","ru":"бе