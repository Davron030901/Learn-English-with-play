","ipa":"praɪz","uz":"sovrin","ru":"приз","ex":["The first prize is a trip."],"u":"S05U15"},{"id":"lex.02699","w":"seminar","pos":"noun","ipa":"ˈsemɪnɑːr","uz":"seminar","ru":"семинар","ex":["The seminar starts at ten."],"u":"S05U15"},{"id":"lex.02700","w":"test","pos":"noun","ipa":"test","uz":"test, sinov","ru":"тест","ex":["The test is on Friday."],"u":"S05U15"},{"id":"lex.02701","w":"assessment","pos":"noun","ipa":"əˈsesmənt","uz":"baholash","ru":"оценка","ex":["The assessment takes an hour."],"u":"S05U15"},{"id":"lex.02702","w":"wisdom","pos":"noun","ipa":"ˈwɪzdəm","uz":"donolik","ru":"мудрость","ex":["She has great wisdom."],"u":"S05U15"},{"id":"lex.02703","w":"understanding","pos":"noun","ipa":"ˌʌndərˈstændɪŋ","uz":"tushunish","ru":"понимание","ex":["He has a good understanding of it."],"u":"S05U15"},{"id":"lex.02704","w":"insight","pos":"noun","ipa":"ˈɪnsaɪt","uz":"chuqur tushunish","ru":"понимание, проницательность","ex":["The book gives real insight."],"u":"S05U15"},{"id":"lex.02705","w":"practical","pos":"adj","ipa":"ˈpræktɪkəl","uz":"amaliy","ru":"практичный","ex":["She is very practical."],"u":"S05U15"},{"id":"lex.02706","w":"mentor","pos":"noun","ipa":"ˈmentɔːr","uz":"ustoz","ru":"наставник","ex":["He became my mentor."],"u":"S05U15"},{"id":"lex.02707","w":"instructor","pos":"noun","ipa":"ɪnˈstrʌktər","uz":"o'qituvchi, instruktor","ru":"инструктор","ex":["My driving instructor was patient."],"u":"S05U15"},{"id":"lex.02708","w":"specialist","pos":"noun","ipa":"ˈspeʃəlɪst","uz":"mutaxassis","ru":"специалист","ex":["She is a specialist in eye surgery."],"u":"S05U15"},{"id":"lex.02709","w":"handy","pos":"adj","ipa":"ˈhændi","uz":"qo'l keladigan, uddaburon","ru":"удобный, умелый","ex":["This tool is very handy."],"u":"S05U15"},{"id":"lex.02710","w":"potential","pos":"noun","ipa":"pəˈtenʃəl","uz":"salohiyat","ru":"потенциал","ex":["She has great potential."],"u":"S05U15"},{"id":"lex.02711","w":"skilful","pos":"adj","ipa":"ˈskɪlfəl","uz":"mohir","ru":"искусный