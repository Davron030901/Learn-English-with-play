n","ru":"назад","ex":["I moved here three years ago."],"u":"S02U06"},{"id":"lex.00621","w":"before","pos":"prep","ipa":"bɪˈfɔːr","uz":"oldin","ru":"до","ex":["I finish before six."],"u":"S02U06"},{"id":"lex.00622","w":"then","pos":"adv","ipa":"ðen","uz":"keyin, o'shanda","ru":"потом","ex":["First we ate, then we walked."],"u":"S02U06"},{"id":"lex.00623","w":"when","pos":"conj","ipa":"wen","uz":"qachon","ru":"когда","ex":["When were you born?"],"u":"S02U06"},{"id":"lex.00624","w":"once","pos":"adv","ipa":"wʌns","uz":"bir marta","ru":"однажды","ex":["I went there once."],"u":"S02U06"},{"id":"lex.00625","w":"last night","pos":"phrase","ipa":"ˌlæst ˈnaɪt","uz":"kecha kechqurun","ru":"вчера вечером","ex":["I watched a film last night."],"u":"S02U06"},{"id":"lex.00626","w":"excited","pos":"adj","ipa":"ɪkˈsaɪtɪd","uz":"hayajonlangan","ru":"взволнованный","ex":["The children are excited about the trip."],"u":"S02U06"},{"id":"lex.00627","w":"surprised","pos":"adj","ipa":"sərˈpraɪzd","uz":"hayron","ru":"удивлённый","ex":["I was very surprised."],"u":"S02U06"},{"id":"lex.00628","w":"nervous","pos":"adj","ipa":"ˈnɜːrvəs","uz":"asabiy, hayajonda","ru":"нервный","ex":["I'm nervous about the exam."],"u":"S02U06"},{"id":"lex.00629","w":"bored","pos":"adj","ipa":"bɔːrd","uz":"zerikkan","ru":"скучающий","ex":["I was bored at the meeting."],"u":"S02U06"},{"id":"lex.00630","w":"interested","pos":"adj","ipa":"ˈɪntrəstɪd","uz":"qiziqqan","ru":"заинтересованный","ex":["I'm interested in history."],"u":"S02U06"},{"id":"lex.00631","w":"glad","pos":"adj","ipa":"ɡlæd","uz":"xursand","ru":"рад","ex":["I'm glad to see you."],"u":"S02U06"},{"id":"lex.00632","w":"birthday","pos":"noun","ipa":"ˈbɜːrθdeɪ","uz":"tug'ilgan kun","ru":"день рождения","ex":["My birthday is in May."],"u":"S02U06"},{"id":"lex.00633","w":"wedding","pos":"noun","ipa":"ˈwedɪŋ","uz":"to'y","ru":"свадьба","ex":["We went to a wedding on Saturday."],"u":"S02U06"},{"id":"lex.00634","w":"exam","pos":"noun","ipa":"ɪɡˈzæm","uz":"imt