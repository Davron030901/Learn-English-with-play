verb","ipa":"ˈbɑːroʊ","uz":"qarz olmoq","ru":"занимать","ex":["Can I borrow your pen?"],"u":"S02U07"},{"id":"lex.00664","w":"lose","pos":"verb","ipa":"luːz","uz":"yo'qotmoq","ru":"терять","ex":["I lost my phone yesterday."],"u":"S02U07"},{"id":"lex.00665","w":"see","pos":"verb","ipa":"siː","uz":"ko'rmoq","ru":"видеть","ex":["I saw her yesterday."],"u":"S02U07"},{"id":"lex.00666","w":"send","pos":"verb","ipa":"send","uz":"jo'natmoq","ru":"отправлять","ex":["I sent her a message."],"u":"S02U07"},{"id":"lex.00667","w":"spend","pos":"verb","ipa":"spend","uz":"sarflamoq","ru":"тратить","ex":["I spent all my money."],"u":"S02U07"},{"id":"lex.00668","w":"win","pos":"verb","ipa":"wɪn","uz":"yutmoq","ru":"выигрывать","ex":["Our team won the match."],"u":"S02U07"},{"id":"lex.00669","w":"fall","pos":"verb","ipa":"fɔːl","uz":"yiqilmoq","ru":"падать","ex":["Be careful — don't fall!"],"u":"S02U07"},{"id":"lex.00670","w":"break","pos":"verb","ipa":"breɪk","uz":"sindirmoq","ru":"ломать","ex":["Don't break the glass."],"u":"S02U07"},{"id":"lex.00671","w":"drop","pos":"verb","ipa":"drɑːp","uz":"tushirib yubormoq","ru":"ронять","ex":["I dropped my phone."],"u":"S02U07"},{"id":"lex.00672","w":"hurt","pos":"verb","ipa":"hɜːrt","uz":"og'rimoq, jarohatlamoq","ru":"болеть, ранить","ex":["My leg hurts."],"u":"S02U07"},{"id":"lex.00673","w":"accident","pos":"noun","ipa":"ˈæksɪdənt","uz":"baxtsiz hodisa","ru":"авария","ex":["There was an accident on the road."],"u":"S02U07"},{"id":"lex.00674","w":"present","pos":"noun","ipa":"ˈprezənt","uz":"sovg'a","ru":"подарок","ex":["I bought a present for my mother."],"u":"S02U07"},{"id":"lex.00675","w":"place","pos":"noun","ipa":"pleɪs","uz":"joy","ru":"место","ex":["This is a nice place."],"u":"S02U07"},{"id":"lex.00676","w":"thing","pos":"noun","ipa":"θɪŋ","uz":"narsa","ru":"вещь","ex":["Put your things here."],"u":"S02U07"},{"id":"lex.00677","w":"after","pos":"prep","ipa":"ˈæftər","uz":"keyin","ru":"после","ex":["I go home after work."],"u":"S02U07"}