u":"ремесло","ex":["Carpet making is an old craft."],"u":"S04U04"},{"id":"lex.01581","w":"fight","pos":"verb","ipa":"faɪt","uz":"kurashmoq","ru":"драться, бороться","ex":["The two armies fought all winter."],"u":"S04U05"},{"id":"lex.01582","w":"die","pos":"verb","ipa":"daɪ","uz":"vafot etmoq","ru":"умирать","ex":["His grandfather died in the war."],"u":"S04U05"},{"id":"lex.01583","w":"empire","pos":"noun","ipa":"ˈempaɪər","uz":"imperiya","ru":"империя","ex":["The empire was very large."],"u":"S04U05"},{"id":"lex.01584","w":"ruler","pos":"noun","ipa":"ˈruːlər","uz":"hukmdor","ru":"правитель","ex":["He was a strong ruler."],"u":"S04U05"},{"id":"lex.01585","w":"king","pos":"noun","ipa":"kɪŋ","uz":"qirol","ru":"король","ex":["The king lived in this palace."],"u":"S04U05"},{"id":"lex.01586","w":"queen","pos":"noun","ipa":"kwiːn","uz":"qirolicha","ru":"королева","ex":["The queen visited the city."],"u":"S04U05"},{"id":"lex.01587","w":"palace","pos":"noun","ipa":"ˈpæləs","uz":"saroy","ru":"дворец","ex":["The palace is open to visitors."],"u":"S04U05"},{"id":"lex.01588","w":"castle","pos":"noun","ipa":"ˈkæsəl","uz":"qal'a","ru":"замок","ex":["We visited an old castle."],"u":"S04U05"},{"id":"lex.01589","w":"tomb","pos":"noun","ipa":"tuːm","uz":"maqbara","ru":"гробница","ex":["The tomb is very old."],"u":"S04U05"},{"id":"lex.01590","w":"trade","pos":"noun","ipa":"treɪd","uz":"savdo","ru":"торговля","ex":["Trade brought money to the city."],"u":"S04U05"},{"id":"lex.01591","w":"route","pos":"noun","ipa":"ruːt","uz":"yo'nalish","ru":"маршрут","ex":["The Silk Route passed through here."],"u":"S04U05"},{"id":"lex.01592","w":"silk","pos":"noun","ipa":"sɪlk","uz":"ipak","ru":"шёлк","ex":["Silk came from China."],"u":"S04U05"},{"id":"lex.01593","w":"merchant","pos":"noun","ipa":"ˈmɜːrtʃənt","uz":"savdogar","ru":"купец","ex":["Merchants travelled for months."],"u":"S04U05"},{"id":"lex.01594","w":"caravan","pos":"noun","ipa":"ˈkærəvæn","uz":"karvon","ru":"караван","ex":["The caravan stopped here for water."],"u":"S04U05"},{"id":"lex.01595","w":"coin","pos":"noun","ipa":"kɔɪn","uz":"tanga","ru":"монета","ex":["They found old coins in the ground."],"u":"S04U05"},{"id":"lex.01596","w":"pottery","pos":"noun","ipa":"ˈpɑːtəri","uz":"sopol buyumlar","ru":"керамика","ex":["The museum has beautiful pottery."],"u":"S04U05"},{"id":"lex.01597","w":"ruin","pos":"noun","ipa":"ˈruːɪn","uz":"vayrona","ru":"развалины","ex":["We walked around the ruins."],"u":"S04U05"},{"id":"lex.01598","w":"restore","pos":"verb","ipa":"rɪˈstɔːr","uz":"qayta tiklamoq","ru":"восстанавливать","ex":["The mosque was restored last year."],"u":"S04U05"},{"id":"lex.01599","w":"preserve","pos":"verb","ipa":"prɪˈzɜːrv","uz":"saqlab qolmoq","ru":"сохранять","ex":["We must preserve these buildings."],"u":"S04U05"},{"id":"lex.01600","w":"heritage","pos":"noun","ipa":"ˈherɪtɪdʒ","uz":"meros","ru":"наследие","ex":["This is part of our heritage."],"u":"S04U05"},{"id":"lex.01601","w":"legend","pos":"noun","ipa":"ˈledʒənd","uz":"afsona","ru":"легенда","ex":["There is a legend about this lake."],"u":"S04U05"},{"id":"lex.01602","w":"dynasty","pos":"noun","ipa":"ˈdaɪnəsti","uz":"sulola","ru":"династия","ex":["The dynasty ruled for 200 years."],"u":"S04U05"},{"id":"lex.01603","w":"invasion","pos":"noun","ipa":"ɪnˈveɪʒən","uz":"bosqin","ru":"вторжение","ex":["The invasion happened in 1220."],"u":"S04U05"},{"id":"lex.01604","w":"fortress","pos":"noun","ipa":"ˈfɔːrtrəs","uz":"qal'a","ru":"крепость","ex":["The fortress protected the town."],"u":"S04U05"},{"id":"lex.01605","w":"dome","pos":"noun","ipa":"doʊm","uz":"gumbaz","ru":"купол","ex":["The blue dome is famous."],"u":"S04U05"},{"id":"lex.01606","w":"scholar","pos":"noun","ipa":"ˈskɑːlər","uz":"olim","ru":"учёный","ex":["Many scholars worked in this city."],"u":"S04U05"},{"id":"lex.01607","w":"inventor","pos":"noun","ipa":"ɪnˈventər","uz":"ixtirochi","ru":"изобретатель","ex":["The inventor was born here."],"u":"S04U05"},{"id":"lex.01608","w":"invention","pos":"noun","ipa":"ɪnˈvenʃən","uz":"ixtiro","ru":"изобретение","ex":["It was an important invention."],"u":"S04U05"},{"id":"lex.01609","w":"treasure","pos":"noun","ipa":"ˈtreʒər","uz":"xazina","ru":"сокровище","ex":["They found treasure under the floor."],"u":"S04U05"},{"id":"lex.01610","w":"emperor","pos":"noun","ipa":"ˈempərər","uz":"imperator","ru":"император","ex":["The emperor lived in the palace."],"u":"S04U05"},{"id":"lex.01611","w":"warrior","pos":"noun","ipa":"ˈwɔːriər","uz":"jangchi","ru":"воин","ex":["The warriors rode horses."],"u":"S04U05"},{"id":"lex.01612","w":"throne","pos":"noun","ipa":"θroʊn","uz":"taxt","ru":"трон","ex":["The throne is made of gold."],"u":"S04U05"},{"id":"lex.01613","w":"crown","pos":"noun","ipa":"kraʊn","uz":"toj","ru":"корона","ex":["The crown is kept in the museum."],"u":"S04U05"},{"id":"lex.01614","w":"archive","pos":"noun","ipa":"ˈɑːrkaɪv","uz":"arxiv","ru":"архив","ex":["The letters are in the archive."],"u":"S04U05"},{"id":"lex.01615","w":"temple","pos":"noun","ipa":"ˈtempəl","uz":"ibodatxona","ru":"храм","ex":["The temple was built long ago."],"u":"S04U05"},{"id":"lex.01616","w":"carving","pos":"noun","ipa":"ˈkɑːrvɪŋ","uz":"o'yma naqsh","ru":"резьба","ex":["The carvings are beautiful."],"u":"S04U05"},{"id":"lex.01617","w":"historian","pos":"noun","ipa":"hɪˈstɔːriən","uz":"tarixchi","ru":"историк","ex":["A historian wrote about this city."],"u":"S04U05"},{"id":"lex.01618","w":"war","pos":"noun","ipa":"wɔːr","uz":"urush","ru":"война","ex":["The war lasted five years."],"u":"S04U05"},{"id":"lex.01619","w":"peace","pos":"noun","ipa":"piːs","uz":"tinchlik","ru":"мир","ex":["The country has been at peace since then."],"u":"S04U05"},{"id":"lex.01620","w":"army","pos":"noun","ipa":"ˈɑːrmi","uz":"qo'shin","ru":"армия","ex":["The army came from the north."],"u":"S04U05"},{"id":"lex.01621","w":"soldier","pos":"noun","ipa":"ˈsoʊldʒər","uz":"askar","ru":"солдат","ex":["The soldiers guarded the gate."],"u":"S04U05"},{"id":"lex.01622","w":"ancestor","pos":"noun","ipa":"ˈænsestər","uz":"ajdod","ru":"предок","ex":["Our ancestors lived in this valley."],"u":"S04U05"},{"id":"lex.01623","w":"merely","pos":"adv","ipa":"ˈmɪrli","uz":"shunchaki","ru":"всего лишь","ex":["I merely asked a question."],"u":"S04U06"},{"id":"lex.01624","w":"exist","pos":"verb","ipa":"ɪɡˈzɪst","uz":"mavjud bo'lmoq","ru":"существовать","ex":["No record of the meeting exists."],"u":"S04U06"},{"id":"lex.01625","w":"conversation","pos":"noun","ipa":"ˌkɑːnvərˈseɪʃən","uz":"suhbat","ru":"разговор","ex":["We had a long conversation."],"u":"S04U06"},{"id":"lex.01626","w":"rumour","pos":"noun","ipa":"ˈruːmər","uz":"mish-mish","ru":"слух","ex":["It is only a rumour."],"u":"S04U06"},{"id":"lex.01627","w":"statement","pos":"noun","ipa":"ˈsteɪtmənt","uz":"bayonot","ru":"заявление","ex":["He made a short statement."],"u":"S04U06"},{"id":"lex.01628","w":"claim","pos":"verb","ipa":"kleɪm","uz":"da'vo qilmoq","ru":"утверждать","ex":["He claims that he was at home."],"u":"S04U06"},{"id":"lex.01629","w":"admit","pos":"verb","ipa":"ədˈmɪt","uz":"tan olmoq","ru":"признавать","ex":["He admitted that he was wrong."],"u":"S04U06"},{"id":"lex.01630","w":"deny","pos":"verb","ipa":"dɪˈnaɪ","uz":"rad etmoq","ru":"отрицать","ex":["He denied everything."],"u":"S04U06"},{"id":"lex.01631","w":"mention","pos":"verb","ipa":"ˈmenʃən","uz":"tilga olmoq","ru":"упоминать","ex":["He did not mention the price."],"u":"S04U06"},{"id":"lex.01632","w":"repeat","pos":"verb","ipa":"rɪˈpiːt","uz":"takrorlamoq","ru":"повторять","ex":["Could you repeat that, please?"],"u":"S04U06"},{"id":"lex.01633","w":"remind","pos":"verb","ipa":"rɪˈmaɪnd","uz":"eslatmoq","ru":"напоминать","ex":["Remind me to call her."],"u":"S04U06"},{"id":"lex.01634","w":"inform","pos":"verb","ipa":"ɪnˈfɔːrm","uz":"xabar bermoq","ru":"информировать","ex":["Please inform your teacher."],"u":"S04U06"},{"id":"lex.01635","w":"whisper","pos":"verb","ipa":"ˈwɪspər","uz":"shivirlamoq","ru":"шептать","ex":["She whispered something to him."],"u":"S04U06"},{"id":"lex.01636","w":"discuss","pos":"verb","ipa":"dɪˈskʌs","uz":"muhokama qilmoq","ru":"обсуждать","ex":["We discussed the plan yesterday."],"u":"S04U06"},{"id":"lex.01637","w":"announce","pos":"verb","ipa":"əˈnaʊns","uz":"e'lon qilmoq","ru":"объявлять","ex":["They announced the results."],"u":"S04U06"},{"id":"lex.01638","w":"declare","pos":"verb","ipa":"dɪˈkler","uz":"e'lon qilmoq, bildirmoq","ru":"объявлять","ex":["He declared that he would not go."],"u":"S04U06"},{"id":"lex.01639","w":"insist","pos":"verb","ipa":"ɪnˈsɪst","uz":"turib olmoq","ru":"настаивать","ex":["He insisted that he was right."],"u":"S04U06"},{"id":"lex.01640","w":"interrupt","pos":"verb","ipa":"ˌɪntəˈrʌpt","uz":"gapini bo'lmoq","ru":"перебивать","ex":["Please do not interrupt me."],"u":"S04U06"},{"id":"lex.01641","w":"persuade","pos":"verb","ipa":"pərˈsweɪd","uz":"ko'ndirmoq","ru":"убеждать","ex":["She persuaded me to come."],"u":"S04U06"},{"id":"lex.01642","w":"convince","pos":"verb","ipa":"kənˈvɪns","uz":"ishontirmoq","ru":"убедить","ex":["He convinced me that it was safe."],"u":"S04U06"},{"id":"lex.01643","w":"criticise","pos":"verb","ipa":"ˈkrɪtɪsaɪz","uz":"tanqid qilmoq","ru":"критиковать","ex":["Do not criticise her work."],"u":"S04U06"},{"id":"lex.01644","w":"praise","pos":"verb","ipa":"preɪz","uz":"maqtamoq","ru":"хвалить","ex":["The teacher praised the students."],"u":"S04U06"},{"id":"lex.01645","w":"blame","pos":"verb","ipa":"bleɪm","uz":"aybdor deb bilmoq","ru":"винить","ex":["Do not blame me."],"u":"S04U06"},{"id":"lex.01646","w":"misunderstand","pos":"verb","ipa":"ˌmɪsʌndərˈstænd","uz":"noto'g'ri tushunmoq","ru":"неправильно понять","ex":["I think you misunderstood me."],"u":"S04U06"},{"id":"lex.01647","w":"remark","pos":"noun","ipa":"rɪˈmɑːrk","uz":"e'tiroz, izoh","ru":"замечание","ex":["He made a rude remark."],"u":"S04U06"},{"id":"lex.01648","w":"comment","pos":"noun","ipa":"ˈkɑːment","uz":"fikr, izoh","ru":"комментарий","ex":["She made no comment."],"u":"S04U06"},{"id":"lex.01649","w":"quote","pos":"verb","ipa":"kwoʊt","uz":"iqtibos keltirmoq","ru":"цитировать","ex":["He quoted his teacher."],"u":"S04U06"},{"id":"lex.01650","w":"chat","pos":"noun","ipa":"tʃæt","uz":"suhbat (norasmiy)","ru":"беседа","ex":["We had a nice chat."],"u":"S04U06"},{"id":"lex.01651","w":"speaker","pos":"noun","ipa":"ˈspiːkər","uz":"so'zlovchi","ru":"говорящий","ex":["The speaker was very clear."],"u":"S04U06"},{"id":"lex.01652","w":"listener","pos":"noun","ipa":"ˈlɪsənər","uz":"tinglovchi","ru":"слушатель","ex":["He is a good listener."],"u":"S04U06"},{"id":"lex.01653","w":"truth","pos":"noun","ipa":"truːθ","uz":"haqiqat","ru":"правда","ex":["Tell me the truth."],"u":"S04U06"},{"id":"lex.01654","w":"lie","pos":"noun","ipa":"laɪ","uz":"yolg'on","ru":"ложь","ex":["That is a lie."],"u":"S04U06"},{"id":"lex.01655","w":"secret","pos":"noun","ipa":"ˈsiːkrət","uz":"sir","ru":"секрет","ex":["Can you keep a secret?"],"u":"S04U06"},{"id":"lex.01656","w":"reply","pos":"noun","ipa":"rɪˈplaɪ","uz":"javob","ru":"ответ","ex":["I am waiting for a reply."],"u":"S04U06"},{"id":"lex.01657","w":"nod","pos":"verb","ipa":"nɑːd","uz":"bosh irg'amoq","ru":"кивать","ex":["He nodded and said nothing."],"u":"S04U06"},{"id":"lex.01658","w":"permit","pos":"verb","ipa":"pərˈmɪt","uz":"ruxsat bermoq","ru":"разрешать","ex":["Smoking is not permitted here."],"u":"S04U07"},{"id":"lex.01659","w":"require","pos":"verb","ipa":"rɪˈkwaɪər","uz":"talab qilmoq","ru":"требовать","ex":["The form requires two signatures."],"u":"S04U07"},{"id":"lex.01660","w":"requirement","pos":"noun","ipa":"rɪˈkwaɪərmənt","uz":"talab","ru":"требование","ex":["There are four requirements and he met three."],"u":"S04U07"},{"id":"lex.01661","w":"convenient","pos":"adj","ipa":"kənˈviːniənt","uz":"qulay","ru":"удобный","ex":["Thursday is more convenient for everyone."],"u":"S04U07"},{"id":"lex.01662","w":"obey","pos":"verb","ipa":"oʊˈbeɪ","uz":"itoat qilmoq","ru":"подчиняться, соблюдать","ex":["Nobody obeys that rule any more."],"u":"S04U07"},{"id":"lex.01663","w":"favour","pos":"noun","ipa":"ˈfeɪvər","uz":"yaxshilik, iltimos","ru":"одолжение","ex":["Can I ask you a favour?"],"u":"S04U07"},{"id":"lex.01664","w":"permission","pos":"noun","ipa":"pərˈmɪʃən","uz":"ruxsat","ru":"разрешение","ex":["You need permission to park here."],"u":"S04U07"},{"id":"lex.01665","w":"allow","pos":"verb","ipa":"əˈlaʊ","uz":"ruxsat bermoq","ru":"разрешать","ex":["They do not allow dogs here."],"u":"S04U07"},{"id":"lex.01666","w":"forbid","pos":"verb","ipa":"fərˈbɪd","uz":"taqiqlamoq","ru":"запрещать","ex":["The school forbids phones in class."],"u":"S04U07"},{"id":"lex.01667","w":"bother","pos":"verb","ipa":"ˈbɑːðər","uz":"bezovta qilmoq","ru":"беспокоить","ex":["Sorry to bother you."],"u":"S04U07"},{"id":"lex.01668","w":"urgent","pos":"adj","ipa":"ˈɜːrdʒənt","uz":"shoshilinch","ru":"срочный","ex":["It is not urgent."],"u":"S04U07"},{"id":"lex.01669","w":"request","pos":"noun","ipa":"rɪˈkwest","uz":"iltimos","ru":"просьба","ex":["I have a small request."],"u":"S04U07"},{"id":"lex.01670","w":"response","pos":"noun","ipa":"rɪˈspɑːns","uz":"javob","ru":"ответ","ex":["There was no response."],"u":"S04U07"},{"id":"lex.01671","w":"grateful","pos":"adj","ipa":"ˈɡreɪtfəl","uz":"minnatdor","ru":"благодарный","ex":["I am very grateful for your help."],"u":"S04U07"},{"id":"lex.01672","w":"thankful","pos":"adj","ipa":"ˈθæŋkfəl","uz":"shukrona","ru":"признательный","ex":["We are thankful that nobody was hurt."],"u":"S04U07"},{"id":"lex.01673","w":"appreciate","pos":"verb","ipa":"əˈpriːʃieɪt","uz":"qadrlamoq","ru":"ценить","ex":["I appreciate your help."],"u":"S04U07"},{"id":"lex.01674","w":"repay","pos":"verb","ipa":"rɪˈpeɪ","uz":"qaytarmoq (qarzni)","ru":"вернуть долг","ex":["I will repay you next week."],"u":"S04U07"},{"id":"lex.01675","w":"kindness","pos":"noun","ipa":"ˈkaɪndnəs","uz":"mehribonlik","ru":"доброта","ex":["Thank you for your kindness."],"u":"S04U07"},{"id":"lex.01676","w":"assistance","pos":"noun","ipa":"əˈsɪstəns","uz":"yordam","ru":"помощь","ex":["Do you need any assistance?"],"u":"S04U07"},{"id":"lex.01677","w":"rescue","pos":"verb","ipa":"ˈreskjuː","uz":"qutqarmoq","ru":"спасать","ex":["They rescued the cat from the tree."],"u":"S04U07"},{"id":"lex.01678","w":"charity","pos":"noun","ipa":"ˈtʃærəti","uz":"xayriya","ru":"благотворительность","ex":["She works for a charity."],"u":"S04U07"},{"id":"lex.01679","w":"donate","pos":"verb","ipa":"ˈdoʊneɪt","uz":"xayriya qilmoq","ru":"жертвовать","ex":["They donated books to the school."],"u":"S04U07"},{"id":"lex.01680","w":"contribute","pos":"verb","ipa":"kənˈtrɪbjuːt","uz":"hissa qo'shmoq","ru":"вносить вклад","ex":["Everyone contributed something."],"u":"S04U07"},{"id":"lex.01681","w":"reward","pos":"noun","ipa":"rɪˈwɔːrd","uz":"mukofot","ru":"награда","ex":["There is a reward for the finder."],"u":"S04U07"},{"id":"lex.01682","w":"plead","pos":"verb","ipa":"pliːd","uz":"yolvormoq","ru":"умолять","ex":["He pleaded with his father."],"u":"S04U07"},{"id":"lex.01683","w":"beg","pos":"verb","ipa":"beɡ","uz":"iltimos qilmoq","ru":"умолять","ex":["I beg you, listen to me."],"u":"S04U07"},{"id":"lex.01684","w":"refusal","pos":"noun","ipa":"rɪˈfjuːzəl","uz":"rad javobi","ru":"отказ","ex":["Her refusal surprised everyone."],"u":"S04U07"},{"id":"lex.01685","w":"consent","pos":"noun","ipa":"kənˈsent","uz":"rozilik","ru":"согласие","ex":["He gave his consent."],"u":"S04U07"},{"id":"lex.01686","w":"errand","pos":"noun","ipa":"ˈerənd","uz":"yumush","ru":"поручение","ex":["I have a few errands this morning."],"u":"S04U07"},{"id":"lex.01687","w":"courtesy","pos":"noun","ipa":"ˈkɜːrtəsi","uz":"odob","ru":"вежливость","ex":["He answered with great courtesy."],"u":"S04U07"},{"id":"lex.01688","w":"helper","pos":"noun","ipa":"ˈhelpər","uz":"yordamchi","ru":"помощник","ex":["We need two helpers on Saturday."],"u":"S04U07"},{"id":"lex.01689","w":"generosity","pos":"noun","ipa":"ˌdʒenəˈrɑːsəti","uz":"saxiylik","ru":"щедрость","ex":["Thank you for your generosity."],"u":"S04U07"},{"id":"lex.01690","w":"thoughtful","pos":"adj","ipa":"ˈθɔːtfəl","uz":"o'ylab ish qiladigan","ru":"внимательный","ex":["That was a thoughtful gift."],"u":"S04U07"},{"id":"lex.01691","w":"selfless","pos":"adj","ipa":"ˈselfləs","uz":"o'zini o'ylamaydigan","ru":"бескорыстный","ex":["It was a selfless act."],"u":"S04U07"},{"id":"lex.01692","w":"duty","pos":"noun","ipa":"ˈduːti","uz":"burch","ru":"долг, обязанность","ex":["It is my duty to help."],"u":"S04U07"},{"id":"lex.01693","w":"gratitude","pos":"noun","ipa":"ˈɡrætɪtuːd","uz":"minnatdorchilik","ru":"благодарность","ex":["She showed her gratitude with a gift."],"u":"S04U07"},{"id":"lex.01694","w":"volunteering","pos":"noun","ipa":"ˌvɑːlənˈtɪrɪŋ","uz":"ko'ngillilik faoliyati","ru":"волонтёрство","ex":["Volunteering takes time but it helps."],"u":"S04U07"},{"id":"lex.01695","w":"involve","pos":"verb","ipa":"ɪnˈvɑlv","uz":"o'z ichiga olmoq","ru":"включать, предполагать","ex":["The role involves a great deal of writing."],"u":"S04U08"},{"id":"lex.01696","w":"unhelpful","pos":"adj","ipa":"ʌnˈhelpfəl","uz":"foyda bermaydigan","ru":"бесполезный, не помогающий","ex":["An unhelpful answer that repeated the question."],"u":"S04U08"},{"id":"lex.01697","w":"development","pos":"noun","ipa":"dɪˈveləpmənt","uz":"rivojlanish","ru":"развитие","ex":["The development of the city was fast."],"u":"S04U08"},{"id":"lex.01698","w":"improvement","pos":"noun","ipa":"ɪmˈpruːvmənt","uz":"yaxshilanish","ru":"улучшение","ex":["There is a big improvement in her English."],"u":"S04U08"},{"id":"lex.01699","w":"growth","pos":"noun","ipa":"ɡroʊθ","uz":"o'sish","ru":"рост","ex":["The growth of the city has been rapid."],"u":"S04U08"},{"id":"lex.01700","w":"decline","pos":"noun","ipa":"dɪˈklaɪn","uz":"pasayish","ru":"спад","ex":["There has been a decline in visitors."],"u":"S04U08"},{"id":"lex.01701","w":"rapidly","pos":"adv","ipa":"ˈræpɪdli","uz":"tez sur'atda","ru":"быстро","ex":["The town has grown rapidly."],"u":"S04U08"},{"id":"lex.01702","w":"gradually","pos":"adv","ipa":"ˈɡrædʒuəli","uz":"asta-sekin","ru":"постепенно","ex":["The weather gradually improved."],"u":"S04U08"},{"id":"lex.01703","w":"industry","pos":"noun","ipa":"ˈɪndəstri","uz":"sanoat","ru":"промышленность","ex":["The cotton industry is important here."],"u":"S04U08"},{"id":"lex.01704","w":"economy","pos":"noun","ipa":"ɪˈkɑːnəmi","uz":"iqtisodiyot","ru":"экономика","ex":["The economy is growing."],"u":"S04U08"},{"id":"lex.01705","w":"achieve","pos":"verb","ipa":"əˈtʃiːv","uz":"erishmoq","ru":"достигать","ex":["She has achieved a lot."],"u":"S04U08"},{"id":"lex.01706","w":"succeed","pos":"verb","ipa":"səkˈsiːd","uz":"muvaffaqiyat qozonmoq","ru":"добиться успеха","ex":["He succeeded at last."],"u":"S04U08"},{"id":"lex.01707","w":"urban","pos":"adj","ipa":"ˈɜːrbən","uz":"shaharga oid","ru":"городской","ex":["Urban life is faster."],"u":"S04U08"},{"id":"lex.01708","w":"rural","pos":"adj","ipa":"ˈrʊrəl","uz":"qishloqqa oid","ru":"сельский","ex":["He grew up in a rural village."],"u":"S04U08"},{"id":"lex.01709","w":"migrate","pos":"verb","ipa":"ˈmaɪɡreɪt","uz":"ko'chib o'tmoq","ru":"мигрировать","ex":["Many families migrated to the city."],"u":"S04U08"},{"id":"lex.01710","w":"settle","pos":"verb","ipa":"ˈsetəl","uz":"joylashmoq","ru":"поселиться","ex":["They settled in Tashkent in 1990."],"u":"S04U08"},{"id":"lex.01711","w":"expand","pos":"verb","ipa":"ɪkˈspænd","uz":"kengaymoq","ru":"расширяться","ex":["The company is expanding."],"u":"S04U08"},{"id":"lex.01712","w":"shrink","pos":"verb","ipa":"ʃrɪŋk","uz":"kichraymoq","ru":"сокращаться","ex":["The village has shrunk."],"u":"S04U08"},{"id":"lex.01713","w":"employment","pos":"noun","ipa":"ɪmˈplɔɪmənt","uz":"bandlik","ru":"занятость","ex":["Employment has risen this year."],"u":"S04U08"},{"id":"lex.01714","w":"unemployment","pos":"noun","ipa":"ˌʌnɪmˈplɔɪmənt","uz":"ishsizlik","ru":"безработица","ex":["Unemployment is a serious problem."],"u":"S04U08"},{"id":"lex.01715","w":"reform","pos":"noun","ipa":"rɪˈfɔːrm","uz":"islohot","ru":"реформа","ex":["The reforms began in 2017."],"u":"S04U08"},{"id":"lex.01716","w":"trend","pos":"noun","ipa":"trend","uz":"tendensiya","ru":"тенденция","ex":["There is a trend towards small families."],"u":"S04U08"},{"id":"lex.01717","w":"shift","pos":"noun","ipa":"ʃɪft","uz":"o'zgarish, siljish","ru":"сдвиг","ex":["There has been a shift in opinion."],"u":"S04U08"},{"id":"lex.01718","w":"innovation","pos":"noun","ipa":"ˌɪnəˈveɪʃən","uz":"innovatsiya","ru":"инновация","ex":["Innovation drives the economy."],"u":"S04U08"},{"id":"lex.01719","w":"advance","pos":"noun","ipa":"ədˈvæns","uz":"taraqqiyot","ru":"прогресс","ex":["There have been great advances in medicine."],"u":"S04U08"},{"id":"lex.01720","w":"workforce","pos":"noun","ipa":"ˈwɜːrkfɔːrs","uz":"ishchi kuchi","ru":"рабочая сила","ex":["The workforce has grown."],"u":"S04U08"},{"id":"lex.01721","w":"prosperity","pos":"noun","ipa":"prɑːˈsperəti","uz":"farovonlik","ru":"процветание","ex":["The country enjoyed years of prosperity."],"u":"S04U08"},{"id":"lex.01722","w":"wage","pos":"noun","ipa":"weɪdʒ","uz":"ish haqi","ru":"зарплата","ex":["Wages have risen this year."],"u":"S04U08"},{"id":"lex.01723","w":"worker","pos":"noun","ipa":"ˈwɜːrkər","uz":"ishchi","ru":"рабочий","ex":["The factory has 200 workers."],"u":"S04U08"},{"id":"lex.01724","w":"hire","pos":"verb","ipa":"ˈhaɪər","uz":"ishga olmoq","ru":"нанимать","ex":["They hired ten new people."],"u":"S04U08"},{"id":"lex.01725","w":"born","pos":"adj","ipa":"bɔːrn","uz":"tug'ilgan","ru":"рождённый","ex":["She was born in 1998."],"u":"S04U08"},{"id":"lex.01726","w":"skilled","pos":"adj","ipa":"skɪld","uz":"malakali","ru":"квалифицированный","ex":["They need skilled workers."],"u":"S04U08"},{"id":"lex.01727","w":"unskilled","pos":"adj","ipa":"ʌnˈskɪld","uz":"malakasiz","ru":"неквалифицированный","ex":["Unskilled work pays less."],"u":"S04U08"},{"id":"lex.01728","w":"labour","pos":"noun","ipa":"ˈleɪbər","uz":"mehnat","ru":"труд","ex":["The work needs a lot of labour."],"u":"S04U08"},{"id":"lex.01729","w":"pension","pos":"noun","ipa":"ˈpenʃən","uz":"nafaqa","ru":"пенсия","ex":["He lives on a small pension."],"u":"S04U08"},{"id":"lex.01730","w":"welfare","pos":"noun","ipa":"ˈwelfer","uz":"ijtimoiy yordam","ru":"социальная помощь","ex":["The welfare system helps poor families."],"u":"S04U08"},{"id":"lex.01731","w":"harsh","pos":"adj","ipa":"hɑrʃ","uz":"qattiq, shafqatsiz","ru":"суровый, резкий","ex":["A harsh winter emptied two villages."],"u":"S04U09"},{"id":"lex.01732","w":"species","pos":"noun","ipa":"ˈspiːʃiːz","uz":"tur (biologik)","ru":"вид","ex":["This species lives only here."],"u":"S04U09"},{"id":"lex.01733","w":"extinct","pos":"adj","ipa":"ɪkˈstɪŋkt","uz":"yo'q bo'lib ketgan","ru":"вымерший","ex":["The bird is now extinct."],"u":"S04U09"},{"id":"lex.01734","w":"wildlife","pos":"noun","ipa":"ˈwaɪldlaɪf","uz":"yovvoyi tabiat","ru":"дикая природа","ex":["The park protects wildlife."],"u":"S04U09"},{"id":"lex.01735","w":"habitat","pos":"noun","ipa":"ˈhæbɪtæt","uz":"yashash muhiti","ru":"среда обитания","ex":["The forest is their habitat."],"u":"S04U09"},{"id":"lex.01736","w":"energy","pos":"noun","ipa":"ˈenərdʒi","uz":"energiya","ru":"энергия","ex":["We must save energy."],"u":"S04U09"},{"id":"lex.01737","w":"solar","pos":"adj","ipa":"ˈsoʊlər","uz":"quyosh (energiyasi)","ru":"солнечный","ex":["They put solar panels on the roof."],"u":"S04U09"},{"id":"lex.01738","w":"fuel","pos":"noun","ipa":"ˈfjuːəl","uz":"yoqilg'i","ru":"топливо","ex":["The car needs fuel."],"u":"S04U09"},{"id":"lex.01739","w":"litter","pos":"noun","ipa":"ˈlɪtər","uz":"axlat (ko'chadagi)","ru":"мусор","ex":["There is litter everywhere."],"u":"S04U09"},{"id":"lex.01740","w":"recycling","pos":"noun","ipa":"riːˈsaɪklɪŋ","uz":"qayta ishlash","ru":"переработка","ex":["Recycling saves materials."],"u":"S04U09"},{"id":"lex.01741","w":"landfill","pos":"noun","ipa":"ˈlændfɪl","uz":"axlatxona","ru":"свалка","ex":["Most rubbish goes to landfill."],"u":"S04U09"},{"id":"lex.01742","w":"emission","pos":"noun","ipa":"ɪˈmɪʃən","uz":"chiqindi gaz","ru":"выброс","ex":["Car emissions are a problem."],"u":"S04U09"},{"id":"lex.01743","w":"carbon","pos":"noun","ipa":"ˈkɑːrbən","uz":"uglerod","ru":"углерод","ex":["Carbon comes from burning fuel."],"u":"S04U09"},{"id":"lex.01744","w":"greenhouse","pos":"noun","ipa":"ˈɡriːnhaʊs","uz":"issiqxona","ru":"теплица","ex":["Tomatoes grow in a greenhouse."],"u":"S04U09"},{"id":"lex.01745","w":"deforest","pos":"verb","ipa":"diːˈfɔːrɪst","uz":"o'rmonni yo'q qilmoq","ru":"вырубать леса","ex":["Large areas have been deforested."],"u":"S04U09"},{"id":"lex.01746","w":"conservation","pos":"noun","ipa":"ˌkɑːnsərˈveɪʃən","uz":"muhofaza","ru":"охрана природы","ex":["Conservation work has saved the birds."],"u":"S04U09"},{"id":"lex.01747","w":"renewable","pos":"adj","ipa":"rɪˈnuːəbəl","uz":"qayta tiklanadigan","ru":"возобновляемый","ex":["Wind is a renewable source."],"u":"S04U09"},{"id":"lex.01748","w":"nuclear","pos":"adj","ipa":"ˈnuːkliər","uz":"yadro","ru":"ядерный","ex":["Nuclear power is used in some countries."],"u":"S04U09"},{"id":"lex.01749","w":"coal","pos":"noun","ipa":"koʊl","uz":"ko'mir","ru":"уголь","ex":["They burn coal for heating."],"u":"S04U09"},{"id":"lex.01750","w":"erosion","pos":"noun","ipa":"ɪˈroʊʒən","uz":"yemirilish","ru":"эрозия","ex":["Erosion has damaged the fields."],"u":"S04U09"},{"id":"lex.01751","w":"sustainable","pos":"adj","ipa":"səˈsteɪnəbəl","uz":"barqaror","ru":"устойчивый","ex":["This is a sustainable way of farming."],"u":"S04U09"},{"id":"lex.01752","w":"organic","pos":"adj","ipa":"ɔːrˈɡænɪk","uz":"organik","ru":"органический","ex":["She buys organic vegetables."],"u":"S04U09"},{"id":"lex.01753","w":"planet","pos":"noun","ipa":"ˈplænɪt","uz":"sayyora","ru":"планета","ex":["We have only one planet."],"u":"S04U09"},{"id":"lex.01754","w":"ocean","pos":"noun","ipa":"ˈoʊʃən","uz":"okean","ru":"океан","ex":["Plastic reaches the ocean."],"u":"S04U09"},{"id":"lex.01755","w":"grass","pos":"noun","ipa":"ɡræs","uz":"o't","ru":"трава","ex":["The children sat on the grass."],"u":"S04U09"},{"id":"lex.01756","w":"bin","pos":"noun","ipa":"bɪn","uz":"axlat quttisi","ru":"мусорное ведро","ex":["Put it in the bin."],"u":"S04U09"},{"id":"lex.01757","w":"polluted","pos":"adj","ipa":"pəˈluːtɪd","uz":"ifloslangan","ru":"загрязнённый","ex":["The river is polluted."],"u":"S04U09"},{"id":"lex.01758","w":"windmill","pos":"noun","ipa":"ˈwɪndmɪl","uz":"shamol tegirmoni","ru":"ветряк","ex":["There are windmills on the hill."],"u":"S04U09"},{"id":"lex.01759","w":"dustbin","pos":"noun","ipa":"ˈdʌstbɪn","uz":"axlat idishi","ru":"мусорный бак","ex":["The dustbins are emptied on Friday."],"u":"S04U09"},{"id":"lex.01760","w":"sewage","pos":"noun","ipa":"ˈsuːɪdʒ","uz":"oqova suv","ru":"сточные воды","ex":["Sewage runs into the river."],"u":"S04U09"},{"id":"lex.01761","w":"pesticide","pos":"noun","ipa":"ˈpestɪsaɪd","uz":"pestitsid","ru":"пестицид","ex":["Pesticides kill useful insects too."],"u":"S04U09"},{"id":"lex.01762","w":"flooding","pos":"noun","ipa":"ˈflʌdɪŋ","uz":"suv bosishi","ru":"затопление","ex":["Flooding damaged the road."],"u":"S04U09"},{"id":"lex.01763","w":"wasteful","pos":"adj","ipa":"ˈweɪstfəl","uz":"isrofgarchilik qiladigan","ru":"расточительный","ex":["It is wasteful to leave the light on."],"u":"S04U09"},{"id":"lex.01764","w":"direct","pos":"verb","ipa":"dəˈrekt","uz":"yo'naltirmoq, buyurmoq","ru":"направлять, предписывать","ex":["The court directed the district to reopen the road."],"u":"S04U10"},{"id":"lex.01765","w":"friendship","pos":"noun","ipa":"ˈfrendʃɪp","uz":"do'stlik","ru":"дружба","ex":["Their friendship lasted fifty years."],"u":"S04U10"},{"id":"lex.01766","w":"relationship","pos":"noun","ipa":"rɪˈleɪʃənʃɪp","uz":"munosabat","ru":"отношения","ex":["They have a good relationship."],"u":"S04U10"},{"id":"lex.01767","w":"divorce","pos":"noun","ipa":"dɪˈvɔːrs","uz":"ajrashish","ru":"развод","ex":["The divorce was difficult for the children."],"u":"S04U10"},{"id":"lex.01768","w":"argument","pos":"noun","ipa":"ˈɑːrɡjumənt","uz":"janjal, bahs","ru":"спор","ex":["They had a big argument."],"u":"S04U10"},{"id":"lex.01769","w":"quarrel","pos":"noun","ipa":"ˈkwɔːrəl","uz":"urishish","ru":"ссора","ex":["It was a small quarrel."],"u":"S04U10"},{"id":"lex.01770","w":"apology","pos":"noun","ipa":"əˈpɑːlədʒi","uz":"uzr","ru":"извинение","ex":["He owes her an apology."],"u":"S04U10"},{"id":"lex.01771","w":"forgive","pos":"verb","ipa":"fərˈɡɪv","uz":"kechirmoq","ru":"прощать","ex":["She forgave him quickly."],"u":"S04U10"},{"id":"lex.01772","w":"trust","pos":"verb","ipa":"trʌst","uz":"ishonmoq","ru":"доверять","ex":["I trust her completely."],"u":"S04U10"},{"id":"lex.01773","w":"loyal","pos":"adj","ipa":"ˈlɔɪəl","uz":"sodiq","ru":"верный","ex":["He is a loyal friend."],"u":"S04U10"},{"id":"lex.01774","w":"supportive","pos":"adj","ipa":"səˈpɔːrtɪv","uz":"qo'llab-quvvatlaydigan","ru":"поддерживающий","ex":["My family is very supportive."],"u":"S04U10"},{"id":"lex.01775","w":"lonely","pos":"adj","ipa":"ˈloʊnli","uz":"yolg'iz","ru":"одинокий","ex":["He felt lonely in the new city."],"u":"S04U10"},{"id":"lex.01776","w":"acquaintance","pos":"noun","ipa":"əˈkweɪntəns","uz":"tanish","ru":"знакомый","ex":["He is an acquaintance, not a friend."],"u":"S04U10"},{"id":"lex.01777","w":"companion","pos":"noun","ipa":"kəmˈpænjən","uz":"hamroh","ru":"спутник","ex":["She was my companion on the trip."],"u":"S04U10"},{"id":"lex.01778","w":"partner","pos":"noun","ipa":"ˈpɑːrtnər","uz":"sherik","ru":"партнёр","ex":["He came with his partner."],"u":"S04U10"},{"id":"lex.01779","w":"engagement","pos":"noun","ipa":"ɪnˈɡeɪdʒmənt","uz":"unashtiruv","ru":"помолвка","ex":["They announced their engagement."],"u":"S04U10"},{"id":"lex.01780","w":"bond","pos":"noun","ipa":"bɑːnd","uz":"rishta","ru":"связь","ex":["There is a strong bond between them."],"u":"S04U10"},{"id":"lex.01781","w":"admire","pos":"verb","ipa":"ədˈmaɪər","uz":"hurmat qilmoq","ru":"восхищаться","ex":["I admire her courage."],"u":"S04U10"},{"id":"lex.01782","w":"tease","pos":"verb","ipa":"tiːz","uz":"hazillashib ermak qilmoq","ru":"дразнить","ex":["They tease him about his hair."],"u":"S04U10"},{"id":"lex.01783","w":"reunion","pos":"noun","ipa":"riːˈjuːnjən","uz":"uchrashuv (qayta)","ru":"воссоединение","ex":["We had a family reunion."],"u":"S04U10"},{"id":"lex.01784","w":"separation","pos":"noun","ipa":"ˌsepəˈreɪʃən","uz":"ajralish","ru":"расставание","ex":["The separation was hard for them."],"u":"S04U10"},{"id":"lex.01785","w":"rival","pos":"noun","ipa":"ˈraɪvəl","uz":"raqib","ru":"соперник","ex":["They were rivals at school."],"u":"S04U10"},{"id":"lex.01786","w":"stranger","pos":"noun","ipa":"ˈstreɪndʒər","uz":"notanish odam","ru":"незнакомец","ex":["A stranger helped me."],"u":"S04U10"},{"id":"lex.01787","w":"closeness","pos":"noun","ipa":"ˈkloʊsnəs","uz":"yaqinlik","ru":"близость","ex":["The closeness of the family helped."],"u":"S04U10"},{"id":"lex.01788","w":"affection","pos":"noun","ipa":"əˈfekʃən","uz":"mehr","ru":"привязанность","ex":["She spoke about him with affection."],"u":"S04U10"},{"id":"lex.01789","w":"quarrelsome","pos":"adj","ipa":"ˈkwɔːrəlsəm","uz":"janjalkash","ru":"склочный","ex":["He becomes quarrelsome when he is tired."],"u":"S04U10"},{"id":"lex.01790","w":"respect","pos":"noun","ipa":"rɪˈspekt","uz":"hurmat","ru":"уважение","ex":["He has great respect for his teacher."],"u":"S04U10"},{"id":"lex.01791","w":"enemy","pos":"noun","ipa":"ˈenəmi","uz":"dushman","ru":"враг","ex":["They were enemies for years."],"u":"S04U10"},{"id":"lex.01792","w":"group","pos":"noun","ipa":"ɡruːp","uz":"guruh","ru":"группа","ex":["A group of students waited outside."],"u":"S04U10"},{"id":"lex.01793","w":"apart","pos":"adv","ipa":"əˈpɑːrt","uz":"alohida","ru":"врозь","ex":["They lived apart for two years."],"u":"S04U10"},{"id":