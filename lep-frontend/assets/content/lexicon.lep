pos":"noun","ipa":"ˈrefərəns","uz":"tavsifnoma","ru":"рекомендация","ex":["He asked me for a reference."],"u":"S05U11"},{"id":"lex.02511","w":"referee","pos":"noun","ipa":"ˌrefəˈriː","uz":"tavsiya beruvchi","ru":"поручитель","ex":["Give the names of two referees."],"u":"S05U11"},{"id":"lex.02512","w":"headway","pos":"noun","ipa":"ˈhedweɪ","uz":"siljish, taraqqiyot","ru":"прогресс","ex":["We are making headway at last."],"u":"S05U11"},{"id":"lex.02513","w":"momentum","pos":"noun","ipa":"moʊˈmentəm","uz":"harakat kuchi","ru":"импульс","ex":["The project has lost momentum."],"u":"S05U11"},{"id":"lex.02514","w":"foothold","pos":"noun","ipa":"ˈfʊthoʊld","uz":"mustahkam o'rin","ru":"точка опоры","ex":["The company gained a foothold there."],"u":"S05U11"},{"id":"lex.02515","w":"code","pos":"noun","ipa":"koʊd","uz":"kodeks, shifr","ru":"кодекс, код","ex":["The advertisement breaks the code."],"u":"S05U12"},{"id":"lex.02516","w":"plug","pos":"noun","ipa":"plʌɡ","uz":"vilka","ru":"вилка, штепсель","ex":["The plug does not fit."],"u":"S05U12"},{"id":"lex.02517","w":"appliance","pos":"noun","ipa":"əˈplaɪəns","uz":"maishiy texnika","ru":"бытовой прибор","ex":["Kitchen appliances are expensive."],"u":"S05U12"},{"id":"lex.02518","w":"device","pos":"noun","ipa":"dɪˈvaɪs","uz":"qurilma","ru":"устройство","ex":["It is a clever little device."],"u":"S05U12"},{"id":"lex.02519","w":"gadget","pos":"noun","ipa":"ˈɡædʒɪt","uz":"qurilmacha","ru":"гаджет","ex":["He loves kitchen gadgets."],"u":"S05U12"},{"id":"lex.02520","w":"equipment","pos":"noun","ipa":"ɪˈkwɪpmənt","uz":"jihoz","ru":"оборудование","ex":["The equipment is old."],"u":"S05U12"},{"id":"lex.02521","w":"adjustment","pos":"noun","ipa":"əˈdʒʌstmənt","uz":"sozlash","ru":"регулировка","ex":["It needs a small adjustment."],"u":"S05U12"},{"id":"lex.02522","w":"installation","pos":"noun","ipa":"ˌɪnstəˈleɪʃən","uz":"o'rnatish","ru":"установка","ex":["Installation takes an hour."],"u":"S05U12"},{"id":"lex.02523","w":"wiring","pos":"noun","ipa":"ˈwaɪərɪŋ","uz":"simlar tizimi","ru":"проводка","ex":["The wiring is very old."],"u":"S05U12"},{"id":"lex.02524","w":"circuit","pos":"noun","ipa":"ˈsɜːrkɪt","uz":"elektr zanjiri","ru":"цепь","ex":["The circuit has broken."],"u":"S05U12"},{"id":"lex.02525","w":"voltage","pos":"noun","ipa":"ˈvoʊltɪdʒ","uz":"kuchlanish","ru":"напряжение","ex":["Check the voltage first."],"u":"S05U12"},{"id":"lex.02526","w":"adapter","pos":"noun","ipa":"əˈdæptər","uz":"adapter","ru":"переходник","ex":["You will need an adapter."],"u":"S05U12"},{"id":"lex.02527","w":"malfunction","pos":"noun","ipa":"mælˈfʌŋkʃən","uz":"nosozlik","ru":"неисправность","ex":["There was a malfunction in the system."],"u":"S05U12"},{"id":"lex.02528","w":"heat","pos":"verb","ipa":"hiːt","uz":"isitmoq","ru":"нагревать","ex":["Heat the oil gently."],"u":"S05U12"},{"id":"lex.02529","w":"freezer","pos":"noun","ipa":"ˈfriːzər","uz":"muzlatgich","ru":"морозильник","ex":["The freezer is full."],"u":"S05U12"},{"id":"lex.02530","w":"oven","pos":"noun","ipa":"ˈʌvən","uz":"pech","ru":"духовка","ex":["The oven is not hot enough."],"u":"S05U12"},{"id":"lex.02531","w":"toaster","pos":"noun","ipa":"ˈtoʊstər","uz":"toster","ru":"тостер","ex":["The toaster has broken again."],"u":"S05U12"},{"id":"lex.02532","w":"vacuum","pos":"noun","ipa":"ˈvækjuːm","uz":"changyutgich","ru":"пылесос","ex":["The vacuum is in the cupboard."],"u":"S05U12"},{"id":"lex.02533","w":"washing","pos":"noun","ipa":"ˈwɑːʃɪŋ","uz":"kir yuvish","ru":"стирка","ex":["The washing is still wet."],"u":"S05U12"},{"id":"lex.02534","w":"dryer","pos":"noun","ipa":"ˈdraɪər","uz":"quritgich","ru":"сушилка","ex":["The dryer takes an hour."],"u":"S05U12"},{"id":"lex.02535","w":"rust","pos":"noun","ipa":"rʌst","uz":"zang","ru":"ржавчина","ex":["There is rust on the gate."],"u":"S05U12"},{"id":"lex.02536","w":"jam","pos":"verb","ipa":"dʒæm","uz":"tiqilib qolmoq","ru":"заедать","ex":["The printer keeps jamming."],"u":"S05U12"},{"id":"lex.02537","w":"block","pos":"verb","ipa":"blɑːk","uz":"to'sib qo'ymoq","ru":"блокировать","ex":["Something is blocking the pipe."],"u":"S05U12"},{"id":"lex.02538","w":"stick","pos":"verb","ipa":"stɪk","uz":"tiqilib qolmoq, yopishmoq","ru":"застревать, приклеивать","ex":["The window sticks in summer."],"u":"S05U12"},{"id":"lex.02539","w":"loose","pos":"adj","ipa":"luːs","uz":"bo'sh","ru":"свободный, шатающийся","ex":["The handle is loose."],"u":"S05U12"},{"id":"lex.02540","w":"tight","pos":"adj","ipa":"taɪt","uz":"mahkam, tor","ru":"тугой, тесный","ex":["The lid is too tight."],"u":"S05U12"},{"id":"lex.02541","w":"damaged","pos":"adj","ipa":"ˈdæmɪdʒd","uz":"shikastlangan","ru":"повреждённый","ex":["The box arrived damaged."],"u":"S05U12"},{"id":"lex.02542","w":"spanner","pos":"noun","ipa":"ˈspænər","uz":"gayka kaliti","ru":"гаечный ключ","ex":["Pass me the spanner."],"u":"S05U12"},{"id":"lex.02543","w":"saw","pos":"noun","ipa":"sɔː","uz":"arra","ru":"пила","ex":["The saw is in the garage."],"u":"S05U12"},{"id":"lex.02544","w":"rope","pos":"noun","ipa":"roʊp","uz":"arqon","ru":"верёвка","ex":["Tie it with a rope."],"u":"S05U12"},{"id":"lex.02545","w":"chain","pos":"noun","ipa":"tʃeɪn","uz":"zanjir","ru":"цепь","ex":["The chain has come off."],"u":"S05U12"},{"id":"lex.02546","w":"hook","pos":"noun","ipa":"hʊk","uz":"ilgak","ru":"крючок","ex":["Hang your coat on the hook."],"u":"S05U12"},{"id":"lex.02547","w":"mirror","pos":"noun","ipa":"ˈmɪrər","uz":"oyna","ru":"зеркало","ex":["The mirror is cracked."],"u":"S05U12"},{"id":"lex.02548","w":"cushion","pos":"noun","ipa":"ˈkʊʃən","uz":"yostiqcha","ru":"подушка (диванная)","ex":["The cushions need washing."],"u":"S05U12"},{"id":"lex.02549","w":"basin","pos":"noun","ipa":"ˈbeɪsən","uz":"rakovina","ru":"раковина","ex":["The basin is blocked."],"u":"S05U12"},{"id":"lex.02550","w":"tap","pos":"noun","ipa":"tæp","uz":"jo'mrak","ru":"кран","ex":["The tap is dripping."],"u":"S05U12"},{"id":"lex.02551","w":"washer","pos":"noun","ipa":"ˈwɑːʃər","uz":"shayba","ru":"шайба, прокладка","ex":["The washer needs replacing."],"u":"S05U12"},{"id":"lex.02552","w":"sink","pos":"noun","ipa":"sɪŋk","uz":"oshxona rakovinasi","ru":"раковина","ex":["The dishes are in the sink."],"u":"S05U12"},{"id":"lex.02553","w":"valve","pos":"noun","ipa":"vælv","uz":"klapan","ru":"клапан","ex":["Close the valve first."],"u":"S05U12"},{"id":"lex.02554","w":"lead","pos":"noun","ipa":"liːd","uz":"shnur, sim","ru":"провод","ex":["The lead is too short."],"u":"S05U12"},{"id":"lex.02555","w":"shade","pos":"noun","ipa":"ʃeɪd","uz":"abajur, soya","ru":"абажур, тень","ex":["The lamp needs a new shade."],"u":"S05U12"},{"id":"lex.02556","w":"pliers","pos":"noun","ipa":"ˈplaɪərz","uz":"ombur","ru":"плоскогубцы","ex":["Hand me the pliers."],"u":"S05U12"},{"id":"lex.02557","w":"wrench","pos":"noun","ipa":"rentʃ","uz":"kalit (gayka uchun)","ru":"гаечный ключ","ex":["Use a wrench for that bolt."],"u":"S05U12"},{"id":"lex.02558","w":"bolt","pos":"noun","ipa":"boʊlt","uz":"bolt","ru":"болт","ex":["Tighten the bolt."],"u":"S05U12"},{"id":"lex.02559","w":"nut","pos":"noun","ipa":"nʌt","uz":"gayka","ru":"гайка","ex":["The nut has come loose."],"u":"S05U12"},{"id":"lex.02560","w":"bracket","pos":"noun","ipa":"ˈbrækɪt","uz":"kronshteyn","ru":"кронштейн","ex":["The shelf needs two brackets."],"u":"S05U12"},{"id":"lex.02561","w":"ladder","pos":"noun","ipa":"ˈlædər","uz":"narvon","ru":"лестница (приставная)","ex":["Hold the ladder for me."],"u":"S05U12"},{"id":"lex.02562","w":"bucket","pos":"noun","ipa":"ˈbʌkɪt","uz":"chelak","ru":"ведро","ex":["Fill the bucket with water."],"u":"S05U12"},{"id":"lex.02563","w":"brush","pos":"noun","ipa":"brʌʃ","uz":"cho'tka","ru":"щётка, кисть","ex":["Clean the brush after painting."],"u":"S05U12"},{"id":"lex.02564","w":"paint","pos":"noun","ipa":"peɪnt","uz":"bo'yoq","ru":"краска","ex":["The paint is still wet."],"u":"S05U12"},{"id":"lex.02565","w":"sealant","pos":"noun","ipa":"ˈsiːlənt","uz":"germetik","ru":"герметик","ex":["Put sealant round the bath."],"u":"S05U12"},{"id":"lex.02566","w":"example","pos":"noun","ipa":"ɪɡˈzæmpəl","uz":"misol","ru":"пример","ex":["Give me an example."],"u":"S05U13"},{"id":"lex.02567","w":"cause","pos":"noun","ipa":"kɔːz","uz":"sabab","ru":"причина","ex":["Nobody knows the cause."],"u":"S05U13"},{"id":"lex.02568","w":"contrast","pos":"noun","ipa":"ˈkɑːntræst","uz":"qarama-qarshilik","ru":"контраст","ex":["There is a sharp contrast between them."],"u":"S05U13"},{"id":"lex.02569","w":"benefit","pos":"noun","ipa":"ˈbenɪfɪt","uz":"foyda","ru":"польза","ex":["The benefits are obvious."],"u":"S05U13"},{"id":"lex.02570","w":"drawback","pos":"noun","ipa":"ˈdrɔːbæk","uz":"kamchilik","ru":"недостаток","ex":["The main drawback is the noise."],"u":"S05U13"},{"id":"lex.02571","w":"implication","pos":"noun","ipa":"ˌɪmplɪˈkeɪʃən","uz":"oqibat, ma'no","ru":"последствие, подтекст","ex":["Consider the implications."],"u":"S05U13"},{"id":"lex.02572","w":"emphasis","pos":"noun","ipa":"ˈemfəsɪs","uz":"urg'u, e'tibor","ru":"акцент","ex":["The emphasis is on speaking."],"u":"S05U13"},{"id":"lex.02573","w":"illustration","pos":"noun","ipa":"ˌɪləˈstreɪʃən","uz":"misol, tasvir","ru":"иллюстрация","ex":["It is a good illustration of the problem."],"u":"S05U13"},{"id":"lex.02574","w":"moreover","pos":"adv","ipa":"mɔːrˈoʊvər","uz":"bundan tashqari","ru":"более того","ex":["Moreover, the cost is lower."],"u":"S05U13"},{"id":"lex.02575","w":"besides","pos":"adv","ipa":"bɪˈsaɪdz","uz":"qolaversa","ru":"кроме того","ex":["Besides, it is too late now."],"u":"S05U13"},{"id":"lex.02576","w":"otherwise","pos":"adv","ipa":"ˈʌðərwaɪz","uz":"aks holda","ru":"иначе","ex":["Leave now, otherwise you will be late."],"u":"S05U13"},{"id":"lex.02577","w":"rather","pos":"adv","ipa":"ˈræðər","uz":"ancha, aksincha","ru":"довольно, скорее","ex":["It was rather difficult."],"u":"S05U13"},{"id":"lex.02578","w":"similarly","pos":"adv","ipa":"ˈsɪmələrli","uz":"xuddi shunday","ru":"аналогично","ex":["Similarly, the second test failed."],"u":"S05U13"},{"id":"lex.02579","w":"however","pos":"adv","ipa":"haʊˈevər","uz":"biroq","ru":"однако","ex":["However, the price is high."],"u":"S05U13"},{"id":"lex.02580","w":"therefore","pos":"adv","ipa":"ˈðerfɔːr","uz":"shuning uchun","ru":"поэтому","ex":["The shop was shut; therefore we went home."],"u":"S05U13"},{"id":"lex.02581","w":"although","pos":"conj","ipa":"ɔːlˈðoʊ","uz":"garchi","ru":"хотя","ex":["Although it was late, we walked."],"u":"S05U13"},{"id":"lex.02582","w":"despite","pos":"prep","ipa":"dɪˈspaɪt","uz":"qaramay","ru":"несмотря на","ex":["Despite the rain, we walked."],"u":"S05U13"},{"id":"lex.02583","w":"whereas","pos":"conj","ipa":"werˈæz","uz":"holbuki","ru":"тогда как","ex":["He likes tea, whereas she prefers coffee."],"u":"S05U13"},{"id":"lex.02584","w":"nevertheless","pos":"adv","ipa":"ˌnevərðəˈles","uz":"shunga qaramay","ru":"тем не менее","ex":["It was hard; nevertheless she finished."],"u":"S05U13"},{"id":"lex.02585","w":"furthermore","pos":"adv","ipa":"ˈfɜːrðərmɔːr","uz":"bundan tashqari","ru":"кроме того","ex":["Furthermore, the results were clear."],"u":"S05U13"},{"id":"lex.02586","w":"consequently","pos":"adv","ipa":"ˈkɑːnsəkwentli","uz":"natijada","ru":"следовательно","ex":["He was late; consequently he missed it."],"u":"S05U13"},{"id":"lex.02587","w":"identical","pos":"adj","ipa":"aɪˈdentɪkəl","uz":"bir xil","ru":"идентичный","ex":["The two copies are identical."],"u":"S05U13"},{"id":"lex.02588","w":"various","pos":"adj","ipa":"ˈveriəs","uz":"turli","ru":"различный","ex":["We tried various methods."],"u":"S05U13"},{"id":"lex.02589","w":"several","pos":"det","ipa":"ˈsevərəl","uz":"bir nechta","ru":"несколько","ex":["Several people were waiting."],"u":"S05U13"},{"id":"lex.02590","w":"numerous","pos":"adj","ipa":"ˈnuːmərəs","uz":"ko'p sonli","ru":"многочисленный","ex":["There were numerous complaints."],"u":"S05U13"},{"id":"lex.02591","w":"countless","pos":"adj","ipa":"ˈkaʊntləs","uz":"son-sanoqsiz","ru":"бесчисленный","ex":["I have told him countless times."],"u":"S05U13"},{"id":"lex.02592","w":"common","pos":"adj","ipa":"ˈkɑːmən","uz":"keng tarqalgan","ru":"распространённый","ex":["It is a common mistake."],"u":"S05U13"},{"id":"lex.02593","w":"chart","pos":"noun","ipa":"tʃɑːrt","uz":"jadval, diagramma","ru":"диаграмма","ex":["Look at the chart on page two."],"u":"S05U13"},{"id":"lex.02594","w":"graph","pos":"noun","ipa":"ɡræf","uz":"grafik","ru":"график","ex":["The graph goes up sharply."],"u":"S05U13"},{"id":"lex.02595","w":"figure","pos":"noun","ipa":"ˈfɪɡjər","uz":"raqam, ko'rsatkich","ru":"цифра","ex":["The figures speak for themselves."],"u":"S05U13"},{"id":"lex.02596","w":"percentage","pos":"noun","ipa":"pərˈsentɪdʒ","uz":"foiz","ru":"процент","ex":["A small percentage disagreed."],"u":"S05U13"},{"id":"lex.02597","w":"total","pos":"noun","ipa":"ˈtoʊtəl","uz":"jami","ru":"итог","ex":["The total came to fifty."],"u":"S05U13"},{"id":"lex.02598","w":"sum","pos":"noun","ipa":"sʌm","uz":"summa","ru":"сумма","ex":["It is a large sum of money."],"u":"S05U13"},{"id":"lex.02599","w":"introduction","pos":"noun","ipa":"ˌɪntrəˈdʌkʃən","uz":"kirish","ru":"введение","ex":["The introduction is too long."],"u":"S05U13"},{"id":"lex.02600","w":"paragraph","pos":"noun","ipa":"ˈpærəɡræf","uz":"xatboshi","ru":"абзац","ex":["Start a new paragraph here."],"u":"S05U13"},{"id":"lex.02601","w":"heading","pos":"noun","ipa":"ˈhedɪŋ","uz":"sarlavha","ru":"заголовок","ex":["Put a heading at the top."],"u":"S05U13"},{"id":"lex.02602","w":"title","pos":"noun","ipa":"ˈtaɪtəl","uz":"nom, sarlavha","ru":"название","ex":["I forgot the title."],"u":"S05U13"},{"id":"lex.02603","w":"topic","pos":"noun","ipa":"ˈtɑːpɪk","uz":"mavzu","ru":"тема","ex":["Let us change the topic."],"u":"S05U13"},{"id":"lex.02604","w":"theme","pos":"noun","ipa":"θiːm","uz":"mavzu, g'oya","ru":"тема","ex":["The main theme is friendship."],"u":"S05U13"},{"id":"lex.02605","w":"point","pos":"noun","ipa":"pɔɪnt","uz":"fikr, nuqta","ru":"пункт, мысль","ex":["That is a good point."],"u":"S05U13"},{"id":"lex.02606","w":"angle","pos":"noun","ipa":"ˈæŋɡəl","uz":"nuqtai nazar, burchak","ru":"угол, точка зрения","ex":["Look at it from another angle."],"u":"S05U13"},{"id":"lex.02607","w":"side","pos":"noun","ipa":"saɪd","uz":"tomon","ru":"сторона","ex":["There are two sides to this."],"u":"S05U13"},{"id":"lex.02608","w":"ground","pos":"noun","ipa":"ɡraʊnd","uz":"asos","ru":"основание","ex":["On what grounds do you say that?"],"u":"S05U13"},{"id":"lex.02609","w":"basis","pos":"noun","ipa":"ˈbeɪsɪs","uz":"asos","ru":"основа","ex":["On what basis was it decided?"],"u":"S05U13"},{"id":"lex.02610","w":"case","pos":"noun","ipa":"keɪs","uz":"holat, dalil","ru":"случай, аргумент","ex":["He made a strong case for it."],"u":"S05U13"},{"id":"lex.02611","w":"parallel","pos":"noun","ipa":"ˈpærəlel","uz":"o'xshashlik","ru":"параллель","ex":["There is a parallel with last year."],"u":"S05U13"},{"id":"lex.02612","w":"aspect","pos":"noun","ipa":"ˈæspekt","uz":"jihat","ru":"аспект","ex":["Consider every aspect of it."],"u":"S05U13"},{"id":"lex.02613","w":"factor","pos":"noun","ipa":"ˈfæktər","uz":"omil","ru":"фактор","ex":["Cost was the deciding factor."],"u":"S05U13"},{"id":"lex.02614","w":"feature","pos":"noun","ipa":"ˈfiːtʃər","uz":"xususiyat","ru":"особенность","ex":["The best feature is the garden."],"u":"S05U13"},{"id":"lex.02615","w":"overview","pos":"noun","ipa":"ˈoʊvərvjuː","uz":"umumiy ko'rinish","ru":"обзор","ex":["Give me a brief overview."],"u":"S05U13"},{"id":"lex.02616","w":"community","pos":"noun","ipa":"kəˈmjuːnəti","uz":"jamoa","ru":"сообщество","ex":["The community raised the money."],"u":"S05U14"},{"id":"lex.02617","w":"authority","pos":"noun","ipa":"əˈθɔːrəti","uz":"hokimiyat, vakolat","ru":"власть","ex":["The local authority decides."],"u":"S05U14"},{"id":"lex.02618","w":"healthcare","pos":"noun","ipa":"ˈhelθker","uz":"sog'liqni saqlash","ru":"здравоохранение","ex":["Healthcare is free here."],"u":"S05U14"},{"i