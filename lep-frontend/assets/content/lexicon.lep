},{"id":"lex.01322","w":"victim","pos":"noun","ipa":"ˈvɪktɪm","uz":"jabrlanuvchi","ru":"жертва","ex":["The victim called the police."],"u":"S03U12"},{"id":"lex.01323","w":"arrest","pos":"verb","ipa":"əˈrest","uz":"hibsga olmoq","ru":"арестовать","ex":["The police arrested two men."],"u":"S03U12"},{"id":"lex.01324","w":"evidence","pos":"noun","ipa":"ˈevɪdəns","uz":"dalil","ru":"доказательство","ex":["There is no evidence against him."],"u":"S03U12"},{"id":"lex.01325","w":"guilty","pos":"adj","ipa":"ˈɡɪlti","uz":"aybdor","ru":"виновный","ex":["The court found him guilty."],"u":"S03U12"},{"id":"lex.01326","w":"innocent","pos":"adj","ipa":"ˈɪnəsənt","uz":"aybsiz","ru":"невиновный","ex":["She says she is innocent."],"u":"S03U12"},{"id":"lex.01327","w":"trial","pos":"noun","ipa":"ˈtraɪəl","uz":"sud jarayoni","ru":"судебный процесс","ex":["The trial begins next week."],"u":"S03U12"},{"id":"lex.01328","w":"suspect","pos":"noun","ipa":"ˈsʌspekt","uz":"gumondor","ru":"подозреваемый","ex":["The police have two suspects."],"u":"S03U12"},{"id":"lex.01329","w":"fair","pos":"adj","ipa":"fer","uz":"adolatli","ru":"справедливый","ex":["The decision was fair."],"u":"S03U12"},{"id":"lex.01330","w":"punish","pos":"verb","ipa":"ˈpʌnɪʃ","uz":"jazolamoq","ru":"наказывать","ex":["The court punished him with a fine."],"u":"S03U12"},{"id":"lex.01331","w":"warn","pos":"verb","ipa":"wɔːrn","uz":"ogohlantirmoq","ru":"предупреждать","ex":["The police warned the drivers."],"u":"S03U12"},{"id":"lex.01332","w":"illegal","pos":"adj","ipa":"ɪˈliːɡəl","uz":"noqonuniy","ru":"незаконный","ex":["It is illegal to park here."],"u":"S03U12"},{"id":"lex.01333","w":"citizen","pos":"noun","ipa":"ˈsɪtɪzən","uz":"fuqaro","ru":"гражданин","ex":["Every citizen has the same rights."],"u":"S03U12"},{"id":"lex.01334","w":"crime","pos":"noun","ipa":"kraɪm","uz":"jinoyat","ru":"преступление","ex":["Crime is low in this town."],"u":"S03U12"},{"id":"lex.01335","w":"thief","pos":"noun","ipa":"θiːf","uz":"o'g'ri","ru":"вор","ex":["The thief took my bag."],"u":"S03U12"},{"id":"lex.01336","w":"steal","pos":"verb","ipa":"stiːl","uz":"o'g'irlamoq","ru":"красть","ex":["Someone stole my phone."],"u":"S03U12"},{"id":"lex.01337","w":"rob","pos":"verb","ipa":"rɑːb","uz":"talamoq","ru":"грабить","ex":["They robbed a bank."],"u":"S03U12"},{"id":"lex.01338","w":"find out","pos":"verb","ipa":"ˌfaɪnd ˈaʊt","uz":"bilib olmoq","ru":"выяснить","ex":["I found out yesterday."],"u":"S03U12"},{"id":"lex.01339","w":"notice","pos":"verb","ipa":"ˈnoʊtɪs","uz":"payqamoq","ru":"замечать","ex":["I didn't notice the sign."],"u":"S03U12"},{"id":"lex.01340","w":"realise","pos":"verb","ipa":"ˈriːəlaɪz","uz":"anglab yetmoq","ru":"осознавать","ex":["I didn't realise it was so late."],"u":"S03U12"},{"id":"lex.01341","w":"explain","pos":"verb","ipa":"ɪkˈspleɪn","uz":"tushuntirmoq","ru":"объяснять","ex":["Can you explain it to me?"],"u":"S03U12"},{"id":"lex.01342","w":"report","pos":"verb","ipa":"rɪˈpɔːrt","uz":"xabar bermoq","ru":"сообщать","ex":["I reported it to the police."],"u":"S03U12"},{"id":"lex.01343","w":"witness","pos":"noun","ipa":"ˈwɪtnəs","uz":"guvoh","ru":"свидетель","ex":["There were two witnesses."],"u":"S03U12"},{"id":"lex.01344","w":"court","pos":"noun","ipa":"kɔːrt","uz":"sud","ru":"суд","ex":["He went to court."],"u":"S03U12"},{"id":"lex.01345","w":"prison","pos":"noun","ipa":"ˈprɪzən","uz":"qamoqxona","ru":"тюрьма","ex":["He spent a year in prison."],"u":"S03U12"},{"id":"lex.01346","w":"fine","pos":"noun","ipa":"faɪn","uz":"jarima","ru":"штраф","ex":["I got a parking fine."],"u":"S03U12"},{"id":"lex.01347","w":"government","pos":"noun","ipa":"ˈɡʌvərnmənt","uz":"hukumat","ru":"правительство","ex":["The government made a new law."],"u":"S03U12"},{"id":"lex.01348","w":"society","pos":"noun","ipa":"səˈsaɪəti","uz":"jamiyat","ru":"общество","ex":["Society is changing."],"u":"S03U12"},{"id":"lex.01349","w":"public","pos":"adj","ipa":"ˈpʌblɪk","uz":"ommaviy","ru":"общественный","ex":["Public transport is cheap here."],"u":"S03U12"},{"id":"lex.01350","w":"private","pos":"adj","ipa":"ˈpraɪvət","uz":"xususiy","ru":"частный","ex":["It is a private school."],"u":"S03U12"},{"id":"lex.01351","w":"accurate","pos":"adj","ipa":"ˈækjərət","uz":"aniq, xatosiz","ru":"точный","ex":["The figures are accurate."],"u":"S03U13"},{"id":"lex.01352","w":"double","pos":"verb","ipa":"ˈdʌbəl","uz":"ikki barobar oshmoq","ru":"удваивать(ся)","ex":["The number of cases doubled in a month."],"u":"S03U13"},{"id":"lex.01353","w":"client","pos":"noun","ipa":"ˈklaɪənt","uz":"mijoz","ru":"клиент","ex":["We met an important client today."],"u":"S03U13"},{"id":"lex.01354","w":"department","pos":"noun","ipa":"dɪˈpɑːrtmənt","uz":"bo'lim","ru":"отдел","ex":["She works in the sales department."],"u":"S03U13"},{"id":"lex.01355","w":"agenda","pos":"noun","ipa":"əˈdʒendə","uz":"kun tartibi","ru":"повестка дня","ex":["What is on the agenda today?"],"u":"S03U13"},{"id":"lex.01356","w":"presentation","pos":"noun","ipa":"ˌpriːzenˈteɪʃən","uz":"taqdimot","ru":"презентация","ex":["My presentation is on Friday."],"u":"S03U13"},{"id":"lex.01357","w":"spreadsheet","pos":"noun","ipa":"ˈspredʃiːt","uz":"jadval fayli","ru":"таблица","ex":["Put the numbers in a spreadsheet."],"u":"S03U13"},{"id":"lex.01358","w":"bonus","pos":"noun","ipa":"ˈboʊnəs","uz":"mukofot pul","ru":"премия","ex":["We got a bonus in December."],"u":"S03U13"},{"id":"lex.01359","w":"negotiation","pos":"noun","ipa":"nɪˌɡoʊʃiˈeɪʃən","uz":"muzokara","ru":"переговоры","ex":["The negotiations took two days."],"u":"S03U13"},{"id":"lex.01360","w":"supplier","pos":"noun","ipa":"səˈplaɪər","uz":"yetkazib beruvchi","ru":"поставщик","ex":["We changed our supplier last year."],"u":"S03U13"},{"id":"lex.01361","w":"invoice","pos":"noun","ipa":"ˈɪnvɔɪs","uz":"hisob-faktura","ru":"счёт","ex":["Please send the invoice by email."],"u":"S03U13"},{"id":"lex.01362","w":"assistant","pos":"noun","ipa":"əˈsɪstənt","uz":"yordamchi","ru":"помощник","ex":["My assistant will ca