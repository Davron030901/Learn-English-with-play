":"weɪt","uz":"kutmoq","ru":"ждать","ex":["Wait a minute, please."],"u":"S01U12"},{"id":"lex.00431","w":"look","pos":"verb","ipa":"lʊk","uz":"qaramoq","ru":"смотреть","ex":["Look at this photo!"],"u":"S01U12"},{"id":"lex.00432","w":"open","pos":"verb","ipa":"ˈoʊpən","uz":"ochmoq","ru":"открывать","ex":["Open the window, please."],"u":"S01U12"},{"id":"lex.00433","w":"close","pos":"verb","ipa":"kloʊz","uz":"yopmoq","ru":"закрывать","ex":["Close the door, please."],"u":"S01U12"},{"id":"lex.00434","w":"carry","pos":"verb","ipa":"ˈkeri","uz":"ko'tarib yurmoq","ru":"нести","ex":["She is carrying a big bag."],"u":"S01U12"},{"id":"lex.00435","w":"smile","pos":"verb","ipa":"smaɪl","uz":"jilmaymoq","ru":"улыбаться","ex":["She is smiling."],"u":"S01U12"},{"id":"lex.00436","w":"laugh","pos":"verb","ipa":"læf","uz":"kulmoq","ru":"смеяться","ex":["The children are laughing."],"u":"S01U12"},{"id":"lex.00437","w":"rain","pos":"verb","ipa":"reɪn","uz":"yomg'ir yog'moq","ru":"идти (о дожде)","ex":["It is raining now."],"u":"S01U12"},{"id":"lex.00438","w":"hard","pos":"adj","ipa":"hɑrd","uz":"qiyin, qattiq","ru":"трудный, твёрдый","ex":["It was a hard question."],"u":"S02U01"},{"id":"lex.00439","w":"understand","pos":"verb","ipa":"ˌʌndərˈstænd","uz":"tushunmoq","ru":"понимать","ex":["I don't understand this word."],"u":"S02U01"},{"id":"lex.00440","w":"believe","pos":"verb","ipa":"bɪˈliːv","uz":"ishonmoq","ru":"верить","ex":["I believe you."],"u":"S02U01"},{"id":"lex.00441","w":"remember","pos":"verb","ipa":"rɪˈmembər","uz":"eslamoq","ru":"помнить","ex":["I remember her name."],"u":"S02U01"},{"id":"lex.00442","w":"forget","pos":"verb","ipa":"fərˈɡet","uz":"unutmoq","ru":"забывать","ex":["I always forget his name."],"u":"S02U01"},{"id":"lex.00443","w":"think","pos":"verb","ipa":"θɪŋk","uz":"o'ylamoq","ru":"думать","ex":["I think it's a good idea."],"u":"S02U01"},{"id":"lex.00444","w":"mean","pos":"verb","ipa":"miːn","uz":"anglatmoq","ru":"значить","ex":["What does this word mean?"],"u":"S02U01"},{"id":"lex.00445","w":"seem","pos":"verb","ipa":"siːm","uz":"ko'rinmoq","ru":"казаться","ex":["She seems tired."],"u":"S02U01"},{"id":"lex.00446","w":"feel","pos":"verb","ipa":"fiːl","uz":"his qilmoq","ru":"чувствовать","ex":["I feel tired today."],"u":"S02U01"},{"id":"lex.00447","w":"belong","pos":"verb","ipa":"bɪˈlɔːŋ","uz":"tegishli bo'lmoq","ru":"принадлежать","ex":["This bag belongs to me."],"u":"S02U01"},{"id":"lex.00448","w":"slowly","pos":"adv","ipa":"ˈsloʊli","uz":"sekin","ru":"медленно","ex":["Please speak slowly."],"u":"S02U01"},{"id":"lex.00449","w":"quickly","pos":"adv","ipa":"ˈkwɪkli","uz":"tez","ru":"быстро","ex":["She works very quickly."],"u":"S02U01"},{"id":"lex.00450","w":"carefully","pos":"adv","ipa":"ˈkerfəli","uz":"ehtiyotkorlik bilan","ru":"осторожно","ex":["Listen carefully, please."],"u":"S02U01"},{"id":"lex.00451","w":"quietly","pos":"adv","ipa":"ˈkwaɪətli","uz":"jimgina","ru":"тихо","ex":["Please speak quietly."],"u":"S02U01"},{"id":"lex.00452","w":"loudly","pos":"adv","ipa":"ˈlaʊdli","uz":"baland ovozda","ru":"громко","ex":["Don't talk so loudly."],"u":"S02U01"},{"id":"lex.00453","w":"badly","pos":"adv","ipa":"ˈbædli","uz":"yomon","ru":"плохо","ex":["He speaks English badly."],"u":"S02U01"},{"id":"lex.00454","w":"hard","pos":"adv","ipa":"hɑːrd","uz":"qattiq, ko'p","ru":"усердно","ex":["She works very hard."],"u":"S02U01"},{"id":"lex.00455","w":"still","pos":"adv","ipa":"stɪl","uz":"hali ham","ru":"всё ещё","ex":["He is still at work."],"u":"S02U01"},{"id":"lex.00456","w":"now","pos":"adv","ipa":"naʊ","uz":"hozir","ru":"сейчас","ex":["What are you doing now?"],"u":"S02U01"},{"id":"lex.00457","w":"moment","pos":"noun","ipa":"ˈmoʊmənt","uz":"lahza","ru":"момент","ex":["Just a moment, please."],"u":"S02U01"},{"id":"lex.00458","w":"at the moment","pos":"phrase","ipa":"ət ðə ˈmoʊmənt","uz":"hozirda","ru":"в данный момент","ex":["I'm working at the moment."],"u":"S02U01"},{"id":"lex.00459","w":"these days","pos":"phrase","ipa":"ðiːz ˈd