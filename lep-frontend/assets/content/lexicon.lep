ack","pos":"noun","ipa":"əˈtæk","uz":"hujum","ru":"нападение, атака","ex":["The article is an attack and it says so."],"u":"S05U08"},{"id":"lex.02311","w":"process","pos":"noun","ipa":"ˈprɑːses","uz":"jarayon","ru":"процесс","ex":["The process takes three days."],"u":"S05U08"},{"id":"lex.02312","w":"method","pos":"noun","ipa":"ˈmeθəd","uz":"usul","ru":"метод","ex":["There is a simpler method."],"u":"S05U08"},{"id":"lex.02313","w":"technique","pos":"noun","ipa":"tekˈniːk","uz":"uslub, texnika","ru":"техника","ex":["She uses an unusual technique."],"u":"S05U08"},{"id":"lex.02314","w":"system","pos":"noun","ipa":"ˈsɪstəm","uz":"tizim","ru":"система","ex":["The system was changed last year."],"u":"S05U08"},{"id":"lex.02315","w":"mechanism","pos":"noun","ipa":"ˈmekənɪzəm","uz":"mexanizm","ru":"механизм","ex":["The mechanism is quite simple."],"u":"S05U08"},{"id":"lex.02316","w":"function","pos":"noun","ipa":"ˈfʌŋkʃən","uz":"vazifa","ru":"функция","ex":["What is the function of this part?"],"u":"S05U08"},{"id":"lex.02317","w":"operate","pos":"verb","ipa":"ˈɑːpəreɪt","uz":"ishlatmoq, ishlamoq","ru":"работать, управлять","ex":["The machine is operated by hand."],"u":"S05U08"},{"id":"lex.02318","w":"assemble","pos":"verb","ipa":"əˈsembəl","uz":"yig'moq","ru":"собирать","ex":["The parts are assembled here."],"u":"S05U08"},{"id":"lex.02319","w":"adjust","pos":"verb","ipa":"əˈdʒʌst","uz":"sozlamoq","ru":"регулировать","ex":["Adjust the height first."],"u":"S05U08"},{"id":"lex.02320","w":"maintain","pos":"verb","ipa":"meɪnˈteɪn","uz":"saqlab turmoq, xizmat ko'rsatmoq","ru":"поддерживать, обслуживать","ex":["The machines are maintained weekly."],"u":"S05U08"},{"id":"lex.02321","w":"component","pos":"noun","ipa":"kəmˈpoʊnənt","uz":"tarkibiy qism","ru":"компонент","ex":["One component is missing."],"u":"S05U08"},{"id":"lex.02322","w":"element","pos":"noun","ipa":"ˈelɪmənt","uz":"unsur","ru":"элемент","ex":["Trust is a key element."],"u":"S05U08"},{"id":"lex.02323","w":"phase","pos":"noun","ipa":"feɪz","uz":"bosqich","ru":"фаза","ex":["We are in the final phase."],"u":"S05U08"},{"id":"lex.02324","w":"sequence","pos":"noun","ipa":"ˈsiːkwəns","uz":"ketma-ketlik","ru":"последовательность","ex":["Follow the sequence exactly."],"u":"S05U08"},{"id":"lex.02325","w":"instruction","pos":"noun","ipa":"ɪnˈstrʌkʃən","uz":"ko'rsatma","ru":"инструкция","ex":["Read the first instruction."],"u":"S05U08"},{"id":"lex.02326","w":"guideline","pos":"noun","ipa":"ˈɡaɪdlaɪn","uz":"yo'riqnoma","ru":"руководство","ex":["The guidelines have been updated."],"u":"S05U08"},{"id":"lex.02327","w":"demonstration","pos":"noun","ipa":"ˌdemənˈstreɪʃən","uz":"namoyish","ru":"демонстрация","ex":["There was a short demonstration."],"u":"S05U08"},{"id":"lex.02328","w":"framework","pos":"noun","ipa":"ˈfreɪmwɜːrk","uz":"asos, ramka","ru":"структура","ex":["The framework is made of steel."],"u":"S05U08"},{"id":"lex.02329","w":"structure","pos":"noun","ipa":"ˈstrʌktʃər","uz":"tuzilma","ru":"структура","ex":["The structure is very strong."],"u":"S05U08"},{"id":"lex.02330","w":"assembly","pos":"noun","ipa":"əˈsembli","uz":"yig'ish","ru":"сборка","ex":["Assembly takes twenty minutes."],"u":"S05U08"},{"id":"lex.02331","w":"production","pos":"noun","ipa":"prəˈdʌkʃən","uz":"ishlab chiqarish","ru":"производство","ex":["Production has been stopped."],"u":"S05U08"},{"id":"lex.02332","w":"efficiency","pos":"noun","ipa":"ɪˈfɪʃənsi","uz":"samaradorlik","ru":"эффективность","ex":["Efficiency has improved."],"u":"S05U08"},{"id":"lex.02333","w":"output","pos":"noun","ipa":"ˈaʊtpʊt","uz":"ishlab chiqarilgan mahsulot","ru":"выпуск","ex":["Output has doubled."],"u":"S05U08"},{"id":"lex.02334","w":"input","pos":"noun","ipa":"ˈɪnpʊt","uz":"kirim, hissa","ru":"вклад, ввод","ex":["We need your input."],"u":"S05U08"},{"id":"lex.02335","w":"engine","pos":"noun","ipa":"ˈendʒɪn","uz":"dvigatel","ru":"двигатель","ex":["The engine has been repaired."],"u":"S05U08"},{"id":"lex.02336","w":"wheel","pos":"noun","ipa"