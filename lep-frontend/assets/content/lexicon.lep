:"S01U09"},{"id":"lex.00325","w":"or","pos":"conj","ipa":"ɔːr","uz":"yoki","ru":"или","ex":["Tea or coffee?"],"u":"S01U09"},{"id":"lex.00326","w":"so","pos":"conj","ipa":"soʊ","uz":"shuning uchun","ru":"поэтому","ex":["I was tired, so I went to bed."],"u":"S01U09"},{"id":"lex.00327","w":"because","pos":"conj","ipa":"bɪˈkʌz","uz":"chunki","ru":"потому что","ex":["I like her because she is kind."],"u":"S01U09"},{"id":"lex.00328","w":"really","pos":"adv","ipa":"ˈriːəli","uz":"rostdan, juda","ru":"действительно","ex":["I really like this song."],"u":"S01U09"},{"id":"lex.00329","w":"me","pos":"pron","ipa":"miː","uz":"menga, meni","ru":"мне, меня","ex":["Give it to me."],"u":"S01U09"},{"id":"lex.00330","w":"him","pos":"pron","ipa":"hɪm","uz":"unga, uni (erkak)","ru":"ему, его","ex":["I know him."],"u":"S01U09"},{"id":"lex.00331","w":"us","pos":"pron","ipa":"ʌs","uz":"bizga, bizni","ru":"нам, нас","ex":["Come with us."],"u":"S01U09"},{"id":"lex.00332","w":"them","pos":"pron","ipa":"ðem","uz":"ularga, ularni","ru":"им, их","ex":["I like them."],"u":"S01U09"},{"id":"lex.00333","w":"name","pos":"verb","ipa":"neɪm","uz":"nom bermoq; aytmoq","ru":"называть","ex":["They named the child after his grandfather."],"u":"S01U10"},{"id":"lex.00334","w":"knife","pos":"noun","ipa":"naɪf","uz":"pichoq","ru":"нож","ex":["The knife is in the kitchen."],"u":"S01U10"},{"id":"lex.00335","w":"fill","pos":"verb","ipa":"fɪl","uz":"to'la qilmoq","ru":"наполнять","ex":["Fill the pot with water."],"u":"S01U10"},{"id":"lex.00336","w":"bread","pos":"noun","ipa":"bred","uz":"non","ru":"хлеб","ex":["We buy bread every morning."],"u":"S01U10"},{"id":"lex.00337","w":"rice","pos":"noun","ipa":"raɪs","uz":"guruch, palov","ru":"рис","ex":["We eat rice with meat."],"u":"S01U10"},{"id":"lex.00338","w":"meat","pos":"noun","ipa":"miːt","uz":"go'sht","ru":"мясо","ex":["I don't eat meat."],"u":"S01U10"},{"id":"lex.00339","w":"chicken","pos":"noun","ipa":"ˈtʃɪkɪn","uz":"tovuq","ru":"курица","ex":["I would like chic