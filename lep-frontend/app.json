{
  "expo": {
    "name": "Learn English with Play",
    "slug": "learn-english-with-play",
    "scheme": "lep",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.learnenglishwithplay"
    },
    "android": {
      "package": "app.learnenglishwithplay",
      "adaptiveIcon": {
        "backgroundColor": "#1E6BF0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Learn English with Play",
      "themeColor": "#1E6BF0"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Speaking practice records your voice so you can hear yourself. Recordings stay on this device.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0D1424"
          }
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
